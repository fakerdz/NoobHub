-- tapPinata = uid con Pinata (neu co) de DON HET pet+tap vao no.
local tapUids, tapN, tapAt, tapCur, tapPinata = {}, 0, -1e9, 0, nil
-- Quét breakable là chỗ ăn CPU nhất: mỗi lần gọi AllByInstanceAndClasses là
-- duyệt toàn bộ + cấp phát bảng mới. Trước đây refreshTargets (0.5s),
-- breakablePositions (mỗi 0.15s qua teleMazeZone), raidComplete và bossAlive
-- đều tự quét riêng -> 4 lần quét/vòng. Giờ gom về 1 cache dùng chung.
local scanAt, scanList, scanBoss = -1e9, {}, false
local function scanBreakables()
	local ck = os.clock()
	if ck - scanAt < (tonumber(CFG.SCAN_EVERY) or 0.5) then return scanList, scanBoss end
	scanAt, scanBoss = ck, false
	table.clear(scanList)
	if not Breakable then return scanList, scanBoss end
	for _, cls in ipairs({ "Normal", "Chest" }) do
		for uid, b in pairs(select(2, pcall(Breakable.AllByInstanceAndClasses, cls)) or {}) do
			local mdl = b.model
			local part = mdl and (mdl:IsA("BasePart") and mdl or mdl.PrimaryPart)
			if part then
				local boss = (b.id == "Pinata")
				if boss then scanBoss = true end
				scanList[#scanList + 1] = { uid = uid, pos = part.Position, boss = boss, model = mdl }
			end
		end
	end
	return scanList, scanBoss
end
-- Giữ model của từng mục tiêu trong RAM: còn Parent nghĩa là chưa vỡ -> khỏi
-- quét lại. Chỉ khi có cái chết (hoặc quá TARGET_REFRESH) mới quét, nên tap vẫn
-- 20 Hz mà CPU gần như bằng 0 lúc đang đập.
local tapModels = {}
local function targetsAlive()
	if tapN == 0 then return false end
	for i = 1, tapN do
		local m = tapModels[i]
		if not (m and m.Parent) then return false end
	end
	return true
end
local function refreshTargets(root)
	if targetsAlive() and os.clock() - tapAt < (tonumber(CFG.TARGET_REFRESH) or 5) then return end
	tapAt = os.clock()
	tapN = 0; tapPinata = nil
	local dist = tonumber(CFG.TAP_DIST) or 90
	local cap = tonumber(CFG.MAX_TARGET) or 14
	local onlyPinata = CFG.CHALLENGE_ONLY_PINATA and CFG.mode == "challenge"   -- challenge: chi con Pinata
	local rp = root.Position
	for _, b in ipairs(scanBreakables()) do        -- dùng chung cache, không tự quét
		if b.boss then
			table.insert(tapUids, 1, b.uid); table.insert(tapModels, 1, b.model)
			tapN = tapN + 1; tapPinata = b.uid
		elseif not onlyPinata and tapN < cap and (b.pos - rp).Magnitude <= dist then
			tapN = tapN + 1; tapUids[tapN] = b.uid; tapModels[tapN] = b.model
		end
	end
	for i = tapN + 1, #tapUids do tapUids[i] = nil end
	for i = tapN + 1, #tapModels do tapModels[i] = nil end
end
-- BẮN REMOTE TRỰC TIẾP ------------------------------------------------------
-- Client.Network.Fire/UnreliableFire gói mỗi lời gọi trong task.spawn(closure):
--   Fire = function(name, ...) local r = _remoteEvent(name)
--       if r then task.spawn(function(...) r:FireServer(...) end, ...) return end
-- -> MỖI cú tap đẻ 1 closure + 1 coroutine. Ở 16 tap/s là ~16 luồng/giây chỉ để
-- gói lại một lời gọi. Lấy thẳng remote trong ReplicatedStorage.Network rồi
-- FireServer: gói tin trên đường truyền y hệt, bỏ phần gói.
-- Tên remote có thể bị băm (Network._getName) -> không tìm thấy thì rơi về Net.
local NETFOLDER = game:GetService("ReplicatedStorage"):FindFirstChild("Network")
local netCache = {}
local function fastFire(name, unreliable, ...)
	local r = netCache[name]
	if r == nil then
		r = (NETFOLDER and NETFOLDER:FindFirstChild(name)) or false
		netCache[name] = r
	end
	if r then
		if pcall(r.FireServer, r, ...) then return end
		netCache[name] = nil                       -- hỏng thì lần sau tra lại
	end
	if unreliable then pcall(Net.UnreliableFire, name, ...) else pcall(Net.Fire, name, ...) end
end
-- PET DAME: list + PIN moi 15s (thieu pin server tuong pet chua "toi noi" -> 0 dame);
-- route + join moi 0.5s. Gan target CO DINH cho tung pet (pet i -> breakable
-- ((i-1)%tapN)+1) - KHONG xoay moi vong (xoay se reset don danh -> mat dame).
-- Van chia deu vi cac pet trai deu len tat ca breakable trong danh sach.
local petE, petN, petListAt, petRouteAt = {}, 0, -1e9, -1e9
-- pool tái dùng: bảng gửi cho server + bảng target theo pet, không cấp phát mỗi lần
local petSet, petJoin, petTT, petSig = {}, {}, {}, nil
local function runPets()
	if not (CFG.PET_DAMAGE and PlayerPet) or tapN == 0 then return end
	local ck = os.clock()
	if ck - petListAt > 15 then
		petListAt = ck; petN = 0
		local anchor
		-- PetNetworking.EquippedPets() là BẢNG STATE TỪ SERVER (key = euid), tồn tại
		-- kể cả khi client không dựng model pet -> tắt render vẫn route được.
		-- PlayerPet.GetByPlayer chỉ có khi model đã dựng, nên chỉ dùng làm dự phòng.
		local list = select(2, pcall(PetNet and PetNet.EquippedPets))
		if type(list) == "table" and next(list) then
			for euid in pairs(list) do
				petN = petN + 1; petE[petN] = euid
				anchor = anchor or {}; anchor[euid] = true
			end
		else
			for _, p in pairs(select(2, pcall(PlayerPet.GetByPlayer, LP)) or {}) do
				if p and p.euid and not p.destroyed then
					petN = petN + 1; petE[petN] = p.euid
					if p.cpet then pcall(function() p.cpet:SetAnchored(true) end) end
					anchor = anchor or {}; anchor[p.euid] = true
				end
			end
		end
		for i = petN + 1, #petE do petE[i] = nil end
		if anchor then fastFire("CQ_Pin", false, anchor) end
	end
	-- Chỉ bắn lại khi MỤC TIÊU đổi (hoặc danh sách pet đổi). Trước đây cứ 0.3s
	-- lại dựng 2 bảng theo số pet + 2 lần Net.Fire dù chẳng có gì thay đổi.
	local focus = CFG.FOCUS_PINATA and tapPinata
	local sig = tostring(focus or tapUids[1]) .. "|" .. tapN .. "|" .. petN
	local beat = tonumber(CFG.PET_HEARTBEAT) or 10   -- nhịp bắn lại phòng server quên
	if petN > 0 and (sig ~= petSig or ck - petRouteAt > beat) then
		petRouteAt, petSig = ck, sig
		table.clear(petSet); table.clear(petJoin)
		for i = 1, petN do
			local uid = focus or tapUids[((i - 1) % tapN) + 1]   -- focus: 1 con; else chia deu
			local t = petTT[petE[i]]                              -- pool bảng, không cấp phát mới
			if not t then t = { t = TT_BREAK, v = uid }; petTT[petE[i]] = t else t.v = uid end
			petSet[petE[i]] = t
			petJoin[petE[i]] = uid
		end
		fastFire("CQ_Route", false, petSet)
		fastFire("Breakables_JoinPetBulk", false, petJoin)
	end
end
-- TỐC ĐỘ TAP THẬT SỰ SERVER NHẬN -------------------------------------------
-- BreakableFrontend.manualTapInterval():
--   power = EnchantCmds.GetPower("Swift Taps")
--   return 1 / (power <= 0 and 8 or math.min(8 * (1 + power/100), 16))
-- Tức nền là 8 tap/s, chỉ lên tới 16 khi ĐANG ĐEO enchant Swift Taps đủ mạnh.
-- Bắn nhanh hơn mức đó là gửi thừa: server bỏ, mà client vẫn tốn CPU đóng gói
-- VÀ vẫn phải nhận gói xác nhận. Không đeo Swift Taps mà để TAP_RATE = 16 là
-- phí đúng một nửa số gói. Đọc power thật rồi tự hạ -> DPS y nguyên.
local tapRate, tapRateAt = nil, -1e9
local function realTapRate()
	local ck = os.clock()
	if tapRate and ck - tapRateAt < 30 then return tapRate end
	tapRateAt = ck
	local want = tonumber(CFG.TAP_RATE) or 16
	local cap = 8
	if CFG.TAP_RATE_AUTO ~= false and EnchantCmds then
		local power = num1(EnchantCmds.GetPower, "Swift Taps")
		if type(power) == "number" and power > 0 then
			cap = math.min(8 * (1 + power / 100), 16)
		end
	elseif CFG.TAP_RATE_AUTO == false then
		cap = want
	end
	tapRate = math.max(1, math.min(want, cap))
	return tapRate
end
-- Budget cộng dồn theo dt: không làm tròn nên không mất phần lẻ như cũ
-- (floor(dt*12+0.5) ở 0.1s luôn ra 1 -> kẹt ~10 tap/s dù cấu hình cao hơn).
local tapBudget = 0
local function runTap(dt)
	if padBusy then return end                       -- đang ra pad gọi Start
	if not Breakable or not (inLobby() or inMaze()) then return end
	local root = hrp(); if not root then return end
	refreshTargets(root)
	if tapN == 0 then return end
	if CFG.AUTO_TAP then   -- tap chia deu de van don breakable thuong (pet moi la dame chinh)
		tapBudget = math.min(tapBudget + dt * realTapRate(), 12)
		while tapBudget >= 1 do
			tapBudget = tapBudget - 1
			tapCur = (tapCur % tapN) + 1
			fastFire("Breakables_PlayerDealDamage", true, tapUids[tapCur])
		end
	end
	runPets()
end

