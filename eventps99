-- FREE GIFTS: claim every ready, unredeemed gift using the game's own remote.
do
	local GiftSave = req("Client.Save")
	local FreeGiftDir = req("Directory.FreeGifts")
	local function isRedeemed(list, id)
		if type(list) ~= "table" then return false end
		if table.find(list, id) then return true end
		return list[tostring(id)] == true or list[id] == true
	end
	local function claimFreeGifts()
		if not (GiftSave and FreeGiftDir and Net) then return end
		local okSave, save = pcall(GiftSave.Get)
		if not (okSave and type(save) == "table") then return end
		local elapsed = tonumber(save.FreeGiftsTime) or 0
		local redeemed = save.FreeGiftsRedeemed
		local ready = {}
		for key, gift in pairs(FreeGiftDir) do
			local id = tonumber(gift and gift.Id or key)
			local waitTime = tonumber(gift and gift.WaitTime)
			if id and waitTime and elapsed >= waitTime and not isRedeemed(redeemed, id) then
				ready[#ready + 1] = id
			end
		end
		table.sort(ready)
		for _, id in ipairs(ready) do
			pcall(Net.Invoke, "Redeem Free Gift", id)
			task.wait(0.25)
		end
	end
	task.spawn(function()
		while alive() do
			pcall(claimFreeGifts)
			task.wait(30)
		end
	end)
end

