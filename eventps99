				while alive() and CFG.ANTI_AFK ~= false do
					task.wait(60)
					pcall(Sig.Fire, "ResetIdleTimer")
				end
			end)
		end
		C[#C + 1] = LP.Idled:Connect(function()
			if Sig then pcall(Sig.Fire, "ResetIdleTimer") end
			local cam = workspace.CurrentCamera; if not cam then return end
			local sid = setidentity or set_thread_identity or setthreadidentity
			if sid then pcall(sid, 8) end
