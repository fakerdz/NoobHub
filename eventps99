	local oldRuntime = ENV.__AUTORANK_LOW_GRAPHIC_RUNTIME or {}
	for _, connection in ipairs(oldRuntime.connections or {}) do pcall(function() connection:Disconnect() end) end
	for _, thread in ipairs(oldRuntime.threads or {}) do pcall(task.cancel, thread) end
	local connections, threads = {}, {}
	ENV.__AUTORANK_LOW_GRAPHIC_RUNTIME = { connections = connections, threads = threads }
	LG.IsAlive = function()
		return ENV.__AUTORANK_LOW_GRAPHIC_RUNTIME
			and ENV.__AUTORANK_LOW_GRAPHIC_RUNTIME.connections == connections
	end
	LG.Connect = function(signal, callback)
		local connection = signal:Connect(callback)
		connections[#connections + 1] = connection
		return connection
	end
	LG.Spawn = function(callback, ...)
		local thread = task.spawn(callback, ...)
		threads[#threads + 1] = thread
		return thread
	end
