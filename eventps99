-- ── LỘT PHÒNG MAZE (dọn BÊN TRONG raid) ───────────────────────────────────
-- Rooms phải giữ nguyên cấu trúc vì đó là SÀN và TƯỜNG của maze, nên dọn ở đây
-- không phải là xoá phòng mà là lột phần chỉ để nhìn trong từng phòng.
--
-- CHỈ xoá theo LỚP (class), không theo tên, và KHÔNG BAO GIỜ xoá BasePart:
--   * BasePart = sàn/tường/cổng. FiestaMazePortals.BindRoom(room) gắn cổng dịch
--     chuyển bằng part bên trong phòng - xoá part là mất đường qua phòng khác.
--   * Decal/Texture/SurfaceAppearance/ParticleEmitter/Trail/Beam/Smoke/Fire/
--     Sparkles/Light/BillboardGui/SurfaceGui/Sound/Highlight thì thuần hiển thị.
--
-- NÓI THẲNG: khi 3D render đã tắt, cái này lấy lại RAM và số instance chứ
-- KHÔNG giảm nhiều CPU - phần vẽ vốn đã bằng 0. Đừng kỳ vọng fps.
--
-- Mỗi phòng lột ĐÚNG MỘT LẦN (bảng seen weak-key), và bám Rooms.ChildAdded nên
-- phòng dựng thêm được lột ngay, không phải quét lại cả maze.
-- KHÔNG GetDescendants ở đây. Chỉ GetChildren + so tên. Tên lấy từ
-- FiestaMazeGeometry nên biết chắc phải so cái gì:
--     makeWall -> v111.Name = `Wall_{cx}_{cy}_{dir}`
--                 v142.Name = `PreviewWall_{cx}_{cy}_{dir}`
--     Floor    -> con trực tiếp của phòng, geometry tự set CanCollide = true
--
-- Bỏ luôn cú FindFirstChild("TeleportPart", true) trước đây: nó CHÍNH LÀ một
-- lượt quét descendant, mà cũng không cần. TeleportPart nằm trong room template
-- chứ không nằm trong tường - BuildPreviewRoom gọi
-- v129:FindFirstChild("TeleportPart", true) trên PHÒNG để xoá nó, và tường của
-- template thì đã bị WallModels():Destroy() dẹp từ lúc build. Nên tường không
-- bao giờ chứa TeleportPart.
--
-- KHÔNG dính:
--   Gate_*        makeWall cũng tạo nhưng tên khác + attribute IsGate -> cửa
--                 thông phòng, filter "Wall" không khớp.
--   TeleportPart  findTeleportParts(): entrance -> LeaveViaExit, end room ->
--                 SendToPrizeRoom (claim() dùng). Mất là không ra được raid.
--   BREAK_ZONES   zonePos() + pet scoping đọc.
local boundRooms = setmetatable({}, { __mode = "k" })
local roomQueue = setmetatable({}, { __mode = "k" })
local function queueRoom(r, delay)
	if not r.Parent then return end
	local at = os.clock() + (delay or 1)
	local q = roomQueue[r]
	if q then q.at, q.left = math.min(q.at, at), math.max(q.left, 3)
	else roomQueue[r] = { at = at, left = 3 } end
end
local function stripRoom(node)
	local walls, floor = on("FP_KillWalls", true), on("FP_KillFloor", true)
	for _, c in ipairs(node:GetChildren()) do
		local kill = (walls and string.find(c.Name, "Wall", 1, true) ~= nil)
			or (floor and c.Name == "Floor")
		if kill then pcall(c.Destroy, c); wsGone += 1 end
	end
end
-- Con của Rooms bị XOÁ CẢ FOLDER, không lột:
--   Checkerboard  BuildCheckerboard tạo Folder tên "Checkerboard" rồi clone
--                 CheckerTemplate thành `Tile_{x}_{y}` cho MỌI ô trong bán kính
--                 (radius+2) -> ((radius+2)*2)^2 part. Đây là chỗ đông nhất
--                 trong maze, mà chỉ là hoa văn nền.
--                 Nó có attribute __FiestaMazeBuilt nên Stop() vốn cũng tự dẹp;
--                 mình chỉ dẹp sớm hơn. Chỗ giữ canvas đều kiểm .Parent trước
--                 khi Destroy nên xoá trước không làm nổ gì.
--                 Tile có CanCollide = true, tức xoá là mất mặt đất GIỮA các
--                 phòng - nhưng FP_KillFloor cũng đã bỏ sàn trong phòng rồi, nên
--                 không thêm rủi ro mới: move() tự tele lại mỗi 0.5s.
local ROOMS_KILL = { Checkerboard = "FP_KillCheckerboard" }
local function handleRoomChild(r)
	if not r.Parent then return end
	local flag = ROOMS_KILL[r.Name]
	if flag and on(flag, true) then pcall(r.Destroy, r); wsGone += 1; return end
	stripRoom(r)
end
local function stripRooms()
	if not gateOk() then return end
	if Inst then
		local ok, model = pcall(Inst.GetModel)
		local rooms = ok and typeof(model) == "Instance" and model:FindFirstChild("Rooms")
		if rooms and not boundRooms[rooms] then
			boundRooms[rooms] = true
			-- Snapshot đúng một lần cho model mới; phòng về sau đi qua queue sự kiện.
			for _, r in ipairs(rooms:GetChildren()) do queueRoom(r, 0) end
			reg("roomsAdded", rooms.ChildAdded, function(r) queueRoom(r, 1) end)
		end
	end
	-- Ba lượt ngắn hứng child gắn muộn rồi bỏ room khỏi queue; không quét toàn
	-- bộ Rooms mãi suốt raid và không tạo task.delay riêng cho từng phòng.
	local now = os.clock()
	for r, q in pairs(roomQueue) do
		if not r.Parent or not r:IsDescendantOf(Workspace) then roomQueue[r] = nil
		elseif now >= q.at then
			handleRoomChild(r); q.left -= 1
			if not r.Parent or q.left <= 0 then roomQueue[r] = nil else q.at = now + 1 end
		end
	end
