-- OrbCmds chạy bằng BindToRenderStep("Orbs", RenderPriority.Last, ...) - KHÔNG
-- phải connection RenderStepped, nên sweepFrames không thấy nó và cũng không
-- được đưa vào danh sách UnbindFromRenderStep.
--
-- Vòng đó làm: pcall(v.RenderStepped, v, ...) cho từng orb
--     trả TRUE  -> orb còn sống: physics, hash vị trí, thử Combine, RenderParticles
--     trả FALSE -> u2[i]=nil; u3-=1; v:Destroy()
--                  if v._collected then chèn v._id + v._combinedIds vào list end
--   và cuối frame:  if #list > 0 then Network.Fire("Orbs: Collect", list) end
--
-- Nên chỉ cần Orb.new trả một BẢNG LUA có _collected=true và RenderStepped trả
-- false: ngay tick đầu là orb vào list và server nhận "Orbs: Collect".
-- Không CreatePart, không physics, không particle, và nhặt được TOÀN KHU - không
-- phụ thuộc tầm hút (DefaultPickupDistance + Magnet upgrade + Magnet enchant).
-- Đây không chỉ là chuyện đồ hoạ mà là THU NHẬP: tắt nó là mất orb rơi xa.
if on("FP_OrbStub", true) then
	pcall(function()
		local cmds = Client:FindFirstChild("OrbCmds")
		local mod = cmds and cmds:FindFirstChild("Orb")
		if not mod then return end
		local Orb = require(mod)
		local proto = {}
		function proto:RenderStepped()
			if self._destroyed then return false end
			self._collected = true
			return false
		end
		function proto:Destroy() self._destroyed = true end
		function proto:RenderParticles() end
		function proto:Combine() return false end
		-- Chữ ký thật: Orb.new(id, t, items, config, cframe, velocity, parentType,
		-- parent, aid). Chỉ id được dùng ở đường collect, phần còn lại bỏ.
		Orb.new = function(id)
			return setmetatable({ _id = id, _destroyed = false, _collected = false,
				_combinedIds = {} }, { __index = proto })
		end
		-- require SAU khi vá: nếu LocalScript nạp OrbCmds đã bị StopScripts tắt thì
		-- BindToRenderStep chưa từng chạy -> không ai nhặt. Tự require là chắc.
		require(cmds)
		R.orb = true
	end)
end


