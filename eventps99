-- AN MODEL PET (nhe RAM) - pet VAN gay dame vi dame tinh o server theo moi tap.
-- ===== CÔNG TẮC HIỆU NĂNG CHÍNH CHỦ CỦA GAME (đọc từ scripts.json) =====
-- 1) Variables.PotatoMode: được kiểm ở 90 chỗ, TRƯỚC KHI TẠO particle/số damage
--    (WorldFX.Damage, BreakableFrontend, OrbCmds.Orb, GUIFX.Sparkles, CustomPet...)
--    -> bật là không sinh instance, khác hẳn việc ẩn sau khi đã tạo.
-- 2) PetNetworking.SetLocalPetsRenderable(false): API gốc, gọi Cleanup() mọi
--    PlayerPet phía client. Damage của pet do SERVER tính nên DPS không đổi.
local function gamePerfSwitches()
	if CFG.POTATO ~= false then
		pcall(function()
			local V = req("Variables")
			if V then
				V.PotatoMode = true
				V.HideProgressUI, V.HideGoalsUI, V.DisableInfoOverlay = true, true, true
				-- Variables.Mobile được kiểm ở 84 chỗ và luôn theo hướng "làm ít đi":
				--   CustomPet.shouldSlowFX / shouldRenderParticles -> tắt particle pet
				--   GUIFX.Tooltip -> trả hàm rỗng | UI dựng ít phần tử hơn
				--   BreakableFrontend.startGlowAnimationTask -> return sớm, bỏ vòng
				--   đọc mouse.Target MỖI FRAME (raycast chuột) suốt phiên chơi.
				if CFG.FAKE_MOBILE ~= false then V.Mobile = true end
			end
		end)
	end
	-- Pet của NGƯỜI KHÁC trong lobby: mỗi người 15+ con, client dựng hết. Damage
	-- của mình không liên quan -> dọn sạch, gặp người mới thì dọn tiếp.
	if CFG.KILL_OTHER_PETS ~= false and PlayerPet then
		local function wipe(pl)
			if pl == LP then return end
			for _, p in pairs(select(2, pcall(PlayerPet.GetByPlayer, pl)) or {}) do
				pcall(function() p:Cleanup() end)
			end
		end
		task.spawn(function()
			local Players = game:GetService("Players")
			pcall(function()
				Players.PlayerAdded:Connect(function(pl) task.delay(3, wipe, pl) end)
			end)
			while alive() do
				for _, pl in ipairs(Players:GetPlayers()) do pcall(wipe, pl) end
				task.wait(tonumber(CFG.OTHER_PETS_EVERY) or 15)
			end
		end)
	end
	-- ==== CẮT LISTENER "MỖI CÚ ĐÁNH" CỦA EVENT ====
	-- BreakableFrontend phát tín hiệu bằng Library.Modules.Event (bảng Lua thường,
	-- handler nằm ở sig._list) chứ không phải RBXScriptSignal -> getconnections
	-- không thấy, Low_Graphic không đụng tới được. Đây là chỗ event ăn CPU theo DPS:
	--   .Damaged      -> chỉ PinataBossBar nghe (tween thanh máu boss MỖI gói damage)
	--   .HitAnimation -> PinataHangFX + Random Events.Pinata (đu đưa + particle mỗi hit)
	-- Cả 2 listener đều thuần hình. Damage do server tính -> cắt không mất DPS.
	-- Không đụng Created/Destroyed/Cleanup/StageChange vì FiestaMazeCmds & ClientPlot
	-- cũng nghe những cái đó (vòng đời breakable).
	if CFG.MUTE_HIT_FX ~= false and Breakable then
		local function mute()
			for _, name in ipairs({ "Damaged", "HitAnimation" }) do
				local sig = Breakable[name]
				local list = type(sig) == "table" and rawget(sig, "_list")
				if type(list) == "table" then
					for i = #list, 1, -1 do
						local c = list[i]
						pcall(function() c:Disconnect() end)
					end
				end
			end
		end
		pcall(mute)
		-- vào/ra instance thì event nối lại listener -> quét lại định kỳ
		task.spawn(function()
			while alive() do
				task.wait(tonumber(CFG.MUTE_HIT_EVERY) or 15)
				pcall(mute)
			end
		end)
	end
	-- ==== DANH SÁCH TRẮNG CHO LISTENER REMOTE ====
	-- Khác hẳn muteNoisyRemotes (chặn 3 cái gọi tên tay): ở đây NGẮT HẾT, chỉ chừa
	-- remote mình thật sự cần. Dump có 457 remote đang được client nghe - phần lớn
	-- là trading, guild, admin, ultimate, farming, world khác... hoàn toàn vô can
	-- với event, nhưng server vẫn đẩy về và client vẫn phải xử.
	-- Đây là đường server -> client, thứ duy nhất tăng theo DPS mà mình còn cắt được.
	if CFG.ONLY_KEEP_REMOTES then
		local getconn = (getgenv and getgenv().getconnections) or getconnections
		local netRoot = game:GetService("ReplicatedStorage"):FindFirstChild("Network")
		if getconn and netRoot then
			local KEEP = {
				-- vòng đời breakable (Breakables_Ping/Created/Destroyed/Cleanup/...)
				"Breakables_",
				-- ra/vào instance: inLobby/inMaze dựa hết vào đây
				"Instancing_", "Instance Gates", "InstanceZones_", "InstanceSurge_",
				-- raid
				"Raids_", "Raid: ", "FFlags Changed",
				-- event: state challenge + ladder (script tự nghe 4 cái này)
				"PinataChallenge_", "Fiesta_",
				-- nhặt orb, pet đang trang bị
				"Orbs:", "Pets_Local",
				-- save/túi/buff: craft, potion, flag, webhook, mail đều đọc từ đây
				"New Stats", "Items: Update", "Potions:", "Fruits:", "Consumables_",
				"FlexibleFlags_", "Flags:", "Effects_Update", "Boosts:", "Buffs:",
				"Map_ZoneChanged", "Transition_",
				-- mail
				"Inbox Updated", "Outbox Updated", "Mailbox:",
				-- server tắt máy -> để game tự xử lý cho tử tế
				"Start Shutdown",
			}
			for _, v in ipairs(CFG.KEEP_REMOTES or {}) do KEEP[#KEEP + 1] = tostring(v) end
			local function sweepRemotes()
				for _, r in ipairs(netRoot:GetChildren()) do
					if r:IsA("RemoteEvent") or r:IsA("UnreliableRemoteEvent") then
						local spare = false
						for _, w in ipairs(KEEP) do
							if string.find(r.Name, w, 1, true) then spare = true break end
						end
						if not spare then
							local ok, list = pcall(getconn, r.OnClientEvent)
							if ok and type(list) == "table" then
								for _, c in ipairs(list) do
									if not pcall(function() c:Disable() end) then
										pcall(function() c:Disconnect() end)
									end
								end
							end
						end
					end
				end
			end
			task.spawn(function()
				while alive() do
					pcall(sweepRemotes)          -- remote stream vào sau -> quét lại
					task.wait(tonumber(CFG.ONLY_KEEP_EVERY) or 30)
				end
			end)
		end
	end
	-- ==== HUỶ 2 LUỒNG HÌNH CỦA BreakableFrontend ====
	-- Cuối module nó task.spawn 2 vòng vô tận, cả 2 thuần hình:
	--   startGlowAnimationTask: RunService.RenderStepped:Wait() + đọc mouse.Target
	--     MỖI FRAME (raycast chuột) để vẽ viền Highlight. Chỉ tự thoát nếu
	--     Variables.Mobile đã bật lúc nó kiểm tra - tức 1 giây sau khi game load,
	--     inject sau mốc đó thì Fake_Mobile không cứu được.
	--   startBillboardTask: while task.wait(0.25) duyệt danh sách HUD breakable.
	-- Nhắm ĐÍCH DANH theo tên hàm, không khớp tên thì bỏ qua (thà không làm gì còn
	-- hơn huỷ nhầm luồng đang tạo breakable).
	if CFG.KILL_GLOW_TASK ~= false and (tonumber(CFG.SAFE_MODE) or 0) <= 0 then
		local gc = (getgenv and getgenv().getgc) or getgc
		if gc then
			local WANT = { startGlowAnimationTask = true, startBillboardTask = true }
			local function sweep()
				local ok, objs = pcall(gc, true)
				if not ok or type(objs) ~= "table" then return end
				for _, o in pairs(objs) do
					if type(o) == "thread" and coroutine.status(o) == "suspended" then
						for lvl = 0, 3 do
							local ok2, src, nm = pcall(debug.info, o, lvl, "sn")
							if not ok2 then break end
							if type(src) == "string" and type(nm) == "string" and WANT[nm]
								and string.find(src, "BreakableFrontend", 1, true) then
								pcall(task.cancel, o)
								break
							end
						end
					end
				end
			end
			task.spawn(function()
				for _ = 1, 3 do                    -- phòng khi module load sau script
					pcall(sweep)
					task.wait(5)
				end
			end)
		end
	end
	if CFG.PET_RENDER == false and PetNet and PetNet.SetLocalPetsRenderable then
		pcall(PetNet.SetLocalPetsRenderable, false)
		-- equip đổi -> game tự dựng lại pet, ép tắt lại
		task.spawn(function()
			while alive() do
				task.wait(tonumber(CFG.PET_RENDER_EVERY) or 20)
				pcall(PetNet.SetLocalPetsRenderable, false)
			end
		end)
	end
end

