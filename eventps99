	local function hideOne(instance)
		local kind = K.KIND[instance.ClassName]
		if kind == 1 then
			instance.Transparency, instance.LocalTransparencyModifier, instance.CastShadow, instance.Reflectance = 1, 1, false, 0
			pcall(function() instance.Material = Enum.Material.SmoothPlastic end)
			if instance.ClassName == "MeshPart" then pcall(function() instance.TextureID = "" end) end
		elseif kind == 2 then pcall(function() instance.TextureId = "" end)
		elseif kind == 3 then instance.Texture, instance.Transparency = "", 1
		elseif kind == 4 then instance.Enabled, instance.Lifetime = false, NumberRange.new(0)
		elseif kind == 5 then instance.Enabled = false
		elseif kind == 6 then instance.Volume = 0
		elseif kind == 7 then instance.Graphic = ""
		elseif kind == 8 then pcall(function() instance[instance.ClassName .. "Template"] = "" end)
		elseif kind == 9 then instance.BlastPressure, instance.BlastRadius = 1, 1
		elseif kind == 11 then pcall(stopAnims, instance)
		elseif kind == 12 and K.ANIM_SCRIPT[instance.Name] then pcall(function() instance.Disabled = true end)
		end
	end
	local function hideTree(root)
