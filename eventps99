-- Cầu nối job() -> add(). add() chỉ có cờ `once`, nên job có `times` thì tự đếm
-- rồi trả "done" - scheduler của file này gỡ job khi thấy "done".
local function job(name, every, fn, times)
	if not times then return add(name, every, fn) end
	local left = times
	add(name, every, function()
		local r = fn(); left = left - 1
		if left <= 0 then return "done" end
		return r
	end)
end

