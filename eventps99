	local function floatChar()
		if CFG.NO_GRAVITY==false then return end
		local ch=LP.Character
		local r=ch and ch:FindFirstChild("HumanoidRootPart"); if not r then return end
		-- KHÔNG dùng gateOk() ở đây: gateOk đòi zoneReady(), mà đúng khoảng nguy
		-- hiểm nhất (vừa vào, chưa có zone, sàn chưa stream) thì zone chưa có ->
		-- trọng lực vẫn bật -> rơi -> watchdog sàn đá ra. Chỉ cần đúng instance.
		local inInst=(id()==tostring(CFG.GATE_INSTANCE or "FiestaMaze")) or eternal()
		local bv=r:FindFirstChild("FiestaFloat")
		if inInst then
			if not bv then
				pcall(function() r.Anchored=false end)
				pcall(function()
					local v=Instance.new("BodyVelocity")
					v.Name,v.Velocity,v.MaxForce,v.P="FiestaFloat",Vector3.zero,Vector3.new(1e9,1e9,1e9),1e5
					v.Parent=r
				end)
			end
		elseif bv then
			pcall(bv.Destroy,bv)
		end
	end
