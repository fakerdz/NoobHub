				local id=tostring(select(2,pcall(it.GetId,it))); local tier=n1(it.GetTier,it) or 0; local match=not want.Id or want.Id=="" or want.Id=="All" or tostring(want.Id)==id
				if want.Tier~=nil then match=match and tier==tonumber(want.Tier) end
				if match then local key=tostring(want.Class).."|"..id.."|"..tier; current[key]={id=id,class=tostring(want.Class),amount=n1(it.GetAmount,it) or 1} end
			end end
