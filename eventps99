		local debris = workspace:FindFirstChild("__DEBRIS")
		if not debris then return end
		local watchedHosts = setmetatable({}, { __mode = "k" })
		local function sweep(child)
			if child.Name == "host" then
				if not watchedHosts[child] then
					watchedHosts[child] = true
					LG.Connect(child.DescendantAdded, function(instance)
						if instance.Name == "HUDAdornee" or instance:IsA("BillboardGui") then task.defer(hideTree, instance) end
