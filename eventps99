CONN = {}
ENV.__FP_CONN = CONN
local function reg(name, signal, fn)
	if CONN[name] then pcall(function() CONN[name]:Disconnect() end) end
	local ok, c = pcall(function() return signal:Connect(fn) end)
	CONN[name] = ok and c or nil
end
local function dropAll()
	for n, c in pairs(CONN) do pcall(function() c:Disconnect() end); CONN[n] = nil end
end

local function gfn(n)
	local v = rawget(ENV, n); if v == nil then v = rawget(_G, n) end
	return type(v) == "function" and v or nil
end
local function srcOf(fn)
	if not (debug and debug.info) then return nil end
	local ok, s = pcall(debug.info, fn, "s")
	return (ok and type(s) == "string" and s ~= "") and s or nil
end

