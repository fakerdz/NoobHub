	local function muteNoisyRemotes()
		local getconn = gfn("getconnections")
		if not getconn then return 0 end
		local net = game:GetService("ReplicatedStorage"):FindFirstChild("Network")
			or game:GetService("ReplicatedStorage"):FindFirstChild("Remotes")
		if not net then return 0 end
		local killed = 0
		for _, name in ipairs({
			"Breakables_UpdateHealth",      -- thanh máu + số damage bay
			"Damage Statistics",            -- bảng thống kê damage
			"Breakables_RenderWorld",       -- vẽ lại breakable trong tầm
		}) do
			local r = net:FindFirstChild(name, true)
			if r then
				for _, sig in ipairs({ "OnClientEvent", "ClientInvoke" }) do
					local ok, list = pcall(getconn, r[sig])
					if ok and type(list) == "table" then
						for _, c in ipairs(list) do
							local done = pcall(function() c:Disable() end)
							if not done then done = pcall(function() c:Disconnect() end) end
							if done then killed = killed + 1 end
						end
					end
				end
			end
		end
		return killed
	end
