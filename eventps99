	-- tới. Lúc vào raid đây đúng là chỗ bão đổ vào: mỗi breakable stream về là
	-- một lần gọi. Nên chưa zoneReady() thì chỉ CẤT tham số lại, xong mới xử.
	-- Giữ nguyên thứ tự sự kiện - cache breakable phụ thuộc thứ tự Created/Stage.
	local pendQ,pendN,pendI={},0,0
	local function drainPending()
		if pendI>=pendN then return end
		while pendI<pendN do
			pendI=pendI+1; local e=pendQ[pendI]; pendQ[pendI]=nil
			if e then pcall(e.fn,table.unpack(e.a,1,e.n)) end
