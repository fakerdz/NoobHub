			if not actors then return end
			local disable = function(root) for _, script in ipairs(root:GetDescendants()) do if script:IsA("LocalScript") or script:IsA("Script") then pcall(function() script.Disabled = true end) end end end
			for _, actor in ipairs(actors:GetChildren()) do disable(actor) end
			LG.Connect(actors.ChildAdded, function(actor) task.defer(disable, actor) end)
		end)
		local function killScript(object)
			if not object:IsA("LocalScript") then return end
			local fullName, hard = object:GetFullName(), false
			for _, word in ipairs(K.HARD_KILL_SCRIPT) do if string.find(fullName, word, 1, true) then hard = true break end end
			if hard then pcall(function() object.Disabled = true; object:Destroy() end); return end
			if object.Disabled then return end
			for _, word in ipairs(K.KEEP_SCRIPT) do if string.find(fullName, word, 1, true) then return end end
			for _, word in ipairs(K.KILL_SCRIPT) do if string.find(fullName, word, 1, true) then pcall(function() object.Disabled = true end); return end end
		end
		local function watchRoot(root)
			if not root then return end
			for _, object in ipairs(root:GetDescendants()) do killScript(object) end
			LG.Connect(root.DescendantAdded, function(object) task.defer(killScript, object) end)
		end
		if LG.SAFE_MODE < 2 then
			watchRoot(LocalPlayer:FindFirstChild("PlayerScripts"))
			watchRoot(LocalPlayer:FindFirstChildOfClass("PlayerGui"))
			watchRoot(LocalPlayer.Character)
			LG.Connect(LocalPlayer.CharacterAdded, function(character) task.defer(watchRoot, character) end)
		end
		local gcKilled, connectionKilled = killGcWorkers(), killRenderConnections()

		pcall(function() local humanoid = LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Humanoid"); if humanoid then humanoid.AutoRotate = false end end)
	end

	-- Đi theo TỪNG NHÁNH con, nghỉ giữa chừng. workspace của PS99 có hàng trăm
	-- nghìn instance: GetDescendants() một phát tạo bảng khổng lồ -> đt tràn RAM chết.
	local breakableWatched = setmetatable({}, { __mode = "k" })
	local function deepHide(root, budget)
		if not root then return end
		pcall(hideOne, root)
		local okKids, kids = pcall(function() return root:GetChildren() end)
		if not okKids then return end
		budget = budget or 0
		for _, child in ipairs(kids) do
			local ok, descendants = pcall(function() return child:GetDescendants() end)
			if ok then
				if #descendants > 6000 then                 -- nhánh quá to -> chia nhỏ tiếp
					deepHide(child, budget)
				else
					pcall(hideOne, child)
					for _, instance in ipairs(descendants) do
						if K.KIND[instance.ClassName] then pcall(hideOne, instance) end
						budget = budget + 1
						if budget % 300 == 0 then task.wait() end
					end
				end
			end
			task.wait()                                     -- nhường frame giữa mỗi nhánh
		end
	end

