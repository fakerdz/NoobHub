local chStartAt = 0
local function runChallenge()
	if not CFG.AUTO_CHALLENGE or not inLobby() then return end
	-- Boss đã được triệu hồi -> ở lại đập, TUYỆT ĐỐI không ra pad nữa
	-- (đây là thứ gây cảnh tele qua lại pad <-> break zone liên tục).
	if bossAlive() then return end
	if os.clock() - chStartAt < (tonumber(CFG.CHALLENGE_RETRY) or 5) then return end
	-- "PinataChallenge: Refresh" chỉ trả BOOLEAN (yêu cầu server đẩy state); state
	-- thật về qua sự kiện PinataChallenge_State -> luôn đọc chState.
	pcall(Net.Invoke, "PinataChallenge: Refresh")
	local s = chState
	if type(s) ~= "table" or s.enabled == false then return end
	local level, maxLevel = tonumber(s.level), tonumber(s.maxLevel)
	if level and maxLevel and level >= maxLevel then return end
	-- HUD hiện displayLevel (= level + 1); limit hiểu theo số HUD.
	local displayLevel = tonumber(s.displayLevel) or ((level or -1) + 1)
	local limit = tonumber(CFG.LIMIT_LEVEL_CHALLENGE) or 0
	if limit > 0 and displayLevel >= limit then return end
	local cost, cur = tonumber(s.nextCost), s.currency
	if cost and cur and Currency then
		local okC, can = pcall(Currency.CanAfford, cur, cost)
		if okC and can == false then return end      -- pcall lỗi thì để server quyết
	end
	chStartAt = os.clock()
	if not startAtPad(s) then return end
	-- XÁC THỰC: chờ boss thật sự hiện ra rồi mới coi là xong (tối đa 5s)
	for _ = 1, 50 do
		if bossAlive() then return end
		task.wait(0.1)
	end
end
