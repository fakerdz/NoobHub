	local vMaze = statRow("Maze Level")
	local vCoins = statRow("Fiesta Coins")
	local vOrb = statRow("Fiesta Orb")
	local vPinata = statRow("Pinata Level")

	local function trim(parent, used)
		local i = used + 1
		while true do local c = parent:FindFirstChild("C" .. i); if not c then break end c.Visible = false; i = i + 1 end
	end
	local function cell(parent, index, icon, corner, bottom)
		local box = parent:FindFirstChild("C" .. index)
		if not box then
			box = uiMake("Frame", { Name = "C" .. index, BackgroundColor3 = Color3.fromRGB(30, 31, 42),
				BorderSizePixel = 0 }, parent)
			uiMake("UICorner", { CornerRadius = UDim.new(0, 8) }, box)
			uiMake("UIStroke", { Thickness = 1, Transparency = 0.55, Color = Color3.fromRGB(105, 108, 138) }, box)
			uiMake("ImageLabel", { Name = "Icon", Size = UDim2.new(1, -14, 0, 30), Position = UDim2.fromOffset(7, 2),
				BackgroundTransparency = 1, ScaleType = Enum.ScaleType.Fit }, box)
			uiMake("TextLabel", { Name = "Corner", Size = UDim2.new(1, -4, 0, 12), Position = UDim2.fromOffset(2, 1),
