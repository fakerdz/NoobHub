-- Server chỉ nhận "PinataChallenge: Start" khi mình ĐỨNG NGOÀI break zone và
-- KHÔNG tap. State có sẵn padPosition + padRadius -> ra đứng đúng pad rồi gọi,
-- xong tele về chỗ cũ.
local function startAtPad(s)
	local root = hrp(); if not root then return false end
	local pad = typeof(s.padPosition) == "Vector3" and s.padPosition
	local back = root.CFrame
	padBusy = true
	local ok = false
	local okRun = pcall(function()
		if pad then
			root.CFrame = CFrame.new(pad + Vector3.new(0, 3, 0))
			task.wait(0.35)                          -- chờ vị trí replicate lên server
		end
		for _ = 1, 3 do
			local okS, res = pcall(Net.Invoke, "PinataChallenge: Start")
			if okS and res ~= false then ok = true break end
			task.wait(0.35)
		end
	end)
	if pad and back then pcall(function() root.CFrame = back end) end
	padBusy = false
	return ok and okRun
