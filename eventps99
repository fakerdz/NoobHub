local padBusy = false

local function petMachinePass(rainbow)
	if not (CFG.RAINBOW ~= false and PetItem and Net) then return false end
	local locked = equippedCount()
	local methodName = rainbow and "CanRainbowMachine" or "CanGoldMachine"
	local remote = rainbow and "RainbowMachine_Activate" or "GoldMachine_Activate"
	local need = math.max(1, 10 - petMachineReduction(rainbow and "RainbowReduction" or "GoldReduction"))
	local eventIds = getFiestaPetIds()
	local candidates = {}
	for _, item in pairs(each(PetItem)) do
		local id = tostring(petMethod(item, "GetId") or "")
		local amount = tonumber(petMethod(item, "GetAmount")) or 0
		local uid = petMethod(item, "GetUID")
		local golden = petMethod(item, "IsGolden") == true
		local rainbowPet = petMethod(item, "IsRainbow") == true
		local normal = petMethod(item, "IsNormal")
		local special = petMethod(item, "IsHuge") or petMethod(item, "IsTitanic") or petMethod(item, "IsGargantuan")
		local exclusive = tonumber(petMethod(item, "GetExclusiveLevel")) or 0
		local valid = rainbow and golden and not rainbowPet or (not rainbow and normal ~= false and not golden and not rainbowPet)
		local can = petMethod(item, methodName)
		local power = petMachinePower(item)
		local free = usableAmount(amount, uid and locked[uid])
		if eventIds[id] and uid and free >= need and power > 0 and valid and not special and exclusive <= 0
			and can ~= false and type(item[methodName]) == "function" then
			candidates[#candidates + 1] = { item = item, uid = uid, power = power }
		end
	end
	table.sort(candidates, function(a, b)
		if a.power == b.power then return tostring(a.uid) < tostring(b.uid) end
		return a.power > b.power
	end)
	if #candidates == 0 then return false end
	local sent = false
	local strongest = candidates[1] and candidates[1].power
	for _, candidate in ipairs(candidates) do
		if candidate.power ~= strongest then break end
		local amount = tonumber(petMethod(candidate.item, "GetAmount")) or 0
		local free = usableAmount(amount, locked[candidate.uid])
		local count = math.floor(free / need)
		if count > 0 then
			local ok, res = pcall(Net.Invoke, remote, candidate.uid, count)
			if ok and res ~= false then
				sent = true
				invDirty = true
				table.clear(INV)
				task.wait(0.35)
			end
		end
	end
	return sent
end
