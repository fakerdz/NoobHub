	if not (CFG.AUTO_UPGRADE and EventUpg and EventUpgDir and Currency) then return end
	local mult = costMult()
	for _, id in ipairs(CFG.UPGRADES or {}) do
		local dir = select(2, pcall(function() return EventUpgDir[id] end))
		if type(dir) == "table" and dir.TierPowers and dir.TierCosts then
			local tier = tonumber((select(2, pcall(EventUpg.GetTier, dir)))) or 0
			if tier < #dir.TierPowers then
				local cost = dir.TierCosts[tier + 1]
				local cid = cost and select(2, pcall(function() return cost:GetId() end))
				local amt = cost and math.ceil((select(2, pcall(function() return cost:GetAmount() end)) or 0) * mult)
				if cid and amt and amt > 0 and select(2, pcall(Currency.CanAfford, cid, amt)) then
					local ok, purchased = pcall(EventUpg.Purchase, dir)
					if ok and purchased and not fast then task.wait(0.2) end
				end end end end
end

-- ============================ RAID (maze) ============================
local function inZone(part, pos)
	if MapCmds and MapCmds.IsPositionInBreakZone then
		local ok, r = pcall(MapCmds.IsPositionInBreakZone, part, pos)
		if ok then return r end
	end
	local rel = part.CFrame:PointToObjectSpace(pos)
	local h = part.Size * 0.5
	return math.abs(rel.X) <= h.X and math.abs(rel.Z) <= h.Z and math.abs(rel.Y) <= h.Y + 100
end
local function breakablePositions() return (scanBreakables()) end
local function portalNumber()
	local ok, n = pcall(function() return Signal.Invoke("Get Portal Number") end)
	if ok and tonumber(n) then return tonumber(n) end
	if ClientRaid and ClientRaid.GetByPortal then   -- kieu game: tim portal trong 1..10
		for i = 1, 10 do
			if not select(2, pcall(ClientRaid.GetByPortal, i)) then return i end
		end
	end
	local root = hrp(); local best, bestD
	for _, m in ipairs(CS:GetTagged("RaidPortal")) do
		local num = tonumber(m.Name)
		local part = m:IsA("BasePart") and m or m.PrimaryPart
		if num and part and root then
			local dd = (part.Position - root.Position).Magnitude
			if not bestD or dd < bestD then best, bestD = num, dd end
		elseif num and not best then best = num end
	end
	return best
end
local function raidPartyMode()
	if not (Raids and Raids.PartyMode) then return nil end
	local name = tostring(CFG.MODE_RAID or "Solo")
	return Raids.PartyMode[name] or Raids.PartyMode.Solo
end

-- Watch the maze progress of each raid. A progress change resets the timer;
-- a completely stalled raid is retried after 180 seconds.
local raidWatchAt, raidWatchCleared, raidWatchTotal = nil, nil, nil
local function readRaidProgress()
	if not FiestaMazeCmds or type(FiestaMazeCmds.Progress) ~= "function" then return nil, nil end
	local ok, cleared, total = pcall(FiestaMazeCmds.Progress)
	if not ok or type(cleared) ~= "number" or type(total) ~= "number" then return nil, nil end
	return cleared, total
end
local function resetRaidWatch()
	raidWatchAt, raidWatchCleared, raidWatchTotal = nil, nil, nil
end
local function armRaidWatch()
	if raidWatchAt then return end
	raidWatchAt = os.clock()
	raidWatchCleared, raidWatchTotal = readRaidProgress()
end
local function raidProgressStalled()
	if not inMaze() then resetRaidWatch() return false end
	armRaidWatch()
	local cleared, total = readRaidProgress()
	if cleared == nil then return false end
	if cleared ~= raidWatchCleared or total ~= raidWatchTotal then
		raidWatchAt = os.clock()
		raidWatchCleared, raidWatchTotal = cleared, total
		return false
	end
	return os.clock() - raidWatchAt >= 180
end

-- Only create this account's raid. A failed create is retried by the controller.
local function startRaid()
	if inMaze() then
		armRaidWatch()
		return true
	end
	if not inLobby() then return false end
	resetRaidWatch()
	local highest = math.max(1, math.floor(tonumber((select(2, pcall(RaidCmds.GetDifficultyLevel)))) or 1))
	local configuredLimit = tonumber(CFG.LIMIT_MAX_TIER)
	local tierLimit = (configuredLimit and configuredLimit < math.huge) and math.floor(configuredLimit) or 0
	local requested = tierLimit > 0 and math.min(highest, tierLimit) or highest
	local ratio = FFlags and FFlags.Keys and FFlags.Keys.RaidMinDifficultyRatio
	local minimum = 1
	if FiestaRaidLevel and ratio then
		local okMin, value = pcall(function()
			return FiestaRaidLevel.MinDifficulty(highest, FFlags.Get(ratio))
		end)
		if okMin then minimum = math.max(1, math.floor(tonumber(value) or 1)) end
	end
	local diff = math.min(highest, math.max(requested, minimum))
	local mode = raidPartyMode()
	local portal = portalNumber()
	if not portal then return false end
	local ok, success, _, raid = pcall(RaidCmds.Create, { Portal = portal, Difficulty = diff, PartyMode = mode })
	if not (ok and success) then return false end
	raid = raid or select(2, pcall(ClientRaid.GetCurrent))
	if not raid then return false end
	local createdDiff = tonumber(select(2, pcall(function() return raid:GetDifficulty() end)))
	if not createdDiff or createdDiff ~= diff then return false end
	local joinOk, joined = pcall(function() return raid:Join() end)
	if not joinOk or joined == false then return false end
	for _ = 1, 30 do
		if not alive() then return false end
		if inMaze() then
			armRaidWatch()
			task.wait(1)
			return true
		end
		task.wait(0.5)
	end
	return inMaze()
end
-- Tele 1 lan vao TAM break zone con breakable (boss uu tien). Sticky de khoi nhay.
local function realRoom(name) return name:match("^Room") or name:match("^Boss") end
local curZone = nil
-- Danh sách BREAK_ZONES của phòng chỉ đổi khi vào raid mới -> cache lại, đừng
-- duyệt Rooms mỗi lần gọi. Kết quả cũng cache theo ZONE_EVERY giây.
local zoneCacheModel, zoneCache = nil, {}
local zoneCfAt, zoneCfRes, zoneCfFb = -1e9, nil, false
local function activeZoneCF()
	if not inMaze() then zoneCacheModel = nil return nil end
	local ck = os.clock()
	if ck - zoneCfAt < (tonumber(CFG.ZONE_EVERY) or 1) then return zoneCfRes, zoneCfFb end
	zoneCfAt = ck
	local function ret(cf, fb) zoneCfRes, zoneCfFb = cf, fb or false return cf, zoneCfFb end
	local root = hrp(); if not root then return ret(nil) end
	local bks = breakablePositions()
	if #bks == 0 then return ret(nil) end
	local model = select(2, pcall(Instancing.GetModel))
	local rooms = model and model:FindFirstChild("Rooms")
	if not rooms then return ret(nil) end
	local zones = zoneCache
	if zoneCacheModel ~= model or #zones == 0 then
		zoneCacheModel, zones = model, {}
		zoneCache = zones
		for _, room in ipairs(rooms:GetChildren()) do
			if realRoom(room.Name) then
				local bz = room:FindFirstChild("BREAK_ZONES")
				if bz then for _, z in ipairs(bz:GetChildren()) do if z:IsA("BasePart") then zones[#zones + 1] = z end end end
			end
		end
	end
	if #zones == 0 then return ret(nil) end
	local score, bossZone = {}, nil
	for _, b in ipairs(bks) do
		for _, z in ipairs(zones) do
			if inZone(z, b.pos) then
				score[z] = (score[z] or 0) + 1
				if b.boss then bossZone = z end
				break
			end end end
	if bossZone then curZone = bossZone; return ret(bossZone.CFrame, false) end
	if curZone and curZone.Parent and score[curZone] then return ret(curZone.CFrame, false) end
	local pick, pickD
	for z in pairs(score) do
		local dd = (z.Position - root.Position).Magnitude
		if not pickD or dd < pickD then pick, pickD = z, dd end
	end
	if pick then curZone = pick; return ret(pick.CFrame, false) end
	curZone = nil
	-- FALLBACK: chưa map được BREAK_ZONES (phòng chưa load / tên phòng lạ) thì bám
	-- thẳng breakable, ưu tiên boss rồi tới cái gần nhất. Không có cái này là đứng
	-- chết một chỗ chờ mapping, phí cả lượt raid.
	local best, bestD
	for _, b in ipairs(bks) do
		if b.boss then return ret(CFrame.new(b.pos), true) end
		local dd = (b.pos - root.Position).Magnitude
		if not bestD or dd < bestD then best, bestD = b.pos, dd end
	end
	if best then return ret(CFrame.new(best), true) end
	return ret(nil)
end
-- LUẬT TELE: trong bán kính TAP_DIST mà CÒN breakable thì ĐỨNG YÊN, khỏi tele.
-- Chỉ đi khi quanh mình sạch trơn (đập hết rồi) - lúc đó mới sang phòng khác.
-- Đứng yên còn giúp pet không bị reset đòn đánh mỗi lần mình nhảy chỗ.
local function breakableNear(root)
	local dist = tonumber(CFG.TAP_DIST) or 220
	local rp = root.Position
	for _, b in ipairs(scanBreakables()) do          -- dùng cache chung, không quét thêm
		if (b.pos - rp).Magnitude <= dist then return true end
	end
	return false
end
-- Khi đã phải đi: mỗi mục tiêu chỉ tele ĐÚNG 1 LẦN. Mục tiêu chưa đổi thì thôi,
-- trừ khi bị xô văng quá TELE_FAR (đã ra khỏi tầm tap).
local teleKey = nil
local raidEntryZoneDone = false
local function teleMazeZone()
	if not (CFG.TELE_ZONE and inMaze()) then
		teleKey = nil
		raidEntryZoneDone = false
		return
	end
	local root = hrp(); if not root then return end
	-- Moi raid: tele thang toi breakable gan nhat dau tien. Neu breakable chua
	-- load thi chua danh dau xong, vong sau se tiep tuc thu.
	if not raidEntryZoneDone then
		local nearest, nearestDist
		for _, b in ipairs(scanBreakables()) do
			local dist = (b.pos - root.Position).Magnitude
			if not nearestDist or dist < nearestDist then
				nearest, nearestDist = b, dist
			end
		end
		if nearest then
			raidEntryZoneDone = true
			curZone = nil
			local p = nearest.pos
			teleKey = ("%d|%d|%d"):format(p.X // 1, p.Y // 1, p.Z // 1)
			root.CFrame = CFrame.new(p + Vector3.new(0, 6, 0))
			return
		end
	end
	-- còn đồ để đập quanh đây -> ở yên. Xoá teleKey để lát nữa hết đồ là đi ngay.
	if CFG.TELE_ONLY_EMPTY ~= false and breakableNear(root) then teleKey = nil return end
	local cf, fallback = activeZoneCF()
	if not cf then return end
	local p = cf.Position
	local key = ("%d|%d|%d"):format(p.X // 1, p.Y // 1, p.Z // 1)
	local far = (root.Position - p).Magnitude > (tonumber(CFG.TELE_FAR) or 220)
	if key == teleKey and not far then return end          -- tới rồi -> thôi
	teleKey = key
	root.CFrame = cf + Vector3.new(0, fallback and 6 or 4, 0)
end
local function raidComplete()
	local raid = select(2, pcall(ClientRaid.GetCurrent))
	if not raid then return false end
	local ok, done = pcall(function() return raid:IsComplete() end)
	if not (ok and done) then return false end
	return #breakablePositions() == 0   -- xong that su = phong cuoi + het breakable
end
