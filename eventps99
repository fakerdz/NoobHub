		LG.Connect(playerGui.ChildAdded, function(gui) task.defer(clean, gui) end)
		LG.Connect(playerGui.DescendantAdded, function(instance)
			local parentGui = instance:FindFirstAncestorWhichIsA("LayerCollector")
			if not parentGui or isKeptGui(parentGui) then return end
			if instance:IsA("LocalScript") then pcall(function() instance.Disabled = true end)
