	local function returnFromChallengePad()
		local r=root(); local p=zonePos()
		if r and p then r.CFrame=CFrame.new(p+Vector3.new(0,3,0))
		elseif r and challengeReturnCF then r.CFrame=challengeReturnCF end
		challengeReturnCF=nil; S.phase="challenge"
	end
	local function challenge()
		local waiting=S.phase=="pad" and challengeReturnCF~=nil
		if not(CFG.AUTO_CHALLENGE and lobby()) then return waiting end
		local boss=select(2,scanBreakables())
		if boss then
			if waiting then returnFromChallengePad(); farmDebug("CHALLENGE_START",0,"accepted=boss-spawned") end
			challengeTry,challengeConfirmUntil=0,-1e9
			return false
		end
		if waiting then
			-- The server validates the pad position. Give the teleport time to replicate,
			-- then retry Start without returning to the break zone on a rejected call.
			if challengeTry>0 and chState and chState.runLevel~=nil then
				returnFromChallengePad(); challengeTry,challengeConfirmUntil=0,clock()+5
				farmDebug("CHALLENGE_START",0,"accepted=state","runLevel=",chState.runLevel)
				return true
			end
			if clock()<challengePadReadyAt then return true end
			challengeTry=challengeTry+1
			local attempt=challengeTry
			local callOK,accepted,reason=invoke("PinataChallenge: Start")
			if callOK and accepted~=false then
				returnFromChallengePad(); challengeTry,challengeConfirmUntil=0,clock()+5
				farmDebug("CHALLENGE_START",0,"accepted=true","response=",accepted,"attempt=",attempt)
				return true
			end
			farmDebug("CHALLENGE_START",num("FARM_DEBUG_EVERY",2),"accepted=false","callOK=",callOK,"reason=",reason or accepted,"attempt=",challengeTry,"holdingPad=true")
			if challengeTry<3 then
				challengePadReadyAt=clock()+.35
			else
				challengeTry=0; challengeAt=clock(); challengePadReadyAt=challengeAt+num("CHALLENGE_RETRY",5)
			end
			return true
		end
		if clock()<challengeConfirmUntil then return true end
		challengeConfirmUntil=-1e9
		if clock()-challengeAt<num("CHALLENGE_RETRY",5) then return false end
		challengeAt=clock(); invoke("PinataChallenge: Refresh"); local s=chState
		if type(s)~="table" or s.enabled==false then return waiting end
		local r=root()
		local l,m=tonumber(s.level),tonumber(s.maxLevel); if l and m and l>=m then return waiting end
		local display=tonumber(s.displayLevel) or ((l or -1)+1); if num("LIMIT_LEVEL_CHALLENGE",0)>0 and display>=num("LIMIT_LEVEL_CHALLENGE",0) then return waiting end
		if s.currency and s.nextCost and Currency and select(2,pcall(Currency.CanAfford,s.currency,s.nextCost))==false then return waiting end
		if not r or typeof(s.padPosition)~="Vector3" then farmDebug("CHALLENGE_START",num("FARM_DEBUG_EVERY",2),"accepted=false","reason=no-root-or-pad"); return waiting end
		if not challengeReturnCF then challengeReturnCF=r.CFrame end
		S.phase="pad"; r.CFrame=CFrame.new(s.padPosition+Vector3.new(0,3,0))
		challengeTry=0; challengePadReadyAt=clock()+.35
		farmDebug("CHALLENGE_PAD",0,"action=teleport","settle=",.35,"maxAttempts=",3)
		return true
	end
