	-- short() của HUD khai mãi dòng ~1710, dùng ở đây là trúng biến TOÀN CỤC nil
	-- rồi "attempt to call a nil value". Dùng bộ rút gọn riêng, khai tại chỗ.
	local function fmt(n)
		n=tonumber(n) or 0
		for _,u in ipairs({{1e12,"T"},{1e9,"B"},{1e6,"M"},{1e3,"K"}}) do
			if n>=u[1] then return ("%.2f%s"):format(n/u[1],u[2]) end
		end
		return tostring(math.floor(n))
	end
	local upgLogged,bstLogged=false,false
	local upgBad={}           -- món server đã từ chối trong lần ghé lobby này
	local function upgrade()
		-- CỔNG = MAZE LEVEL, không phải pinata level.
		-- Lý do: FFlag PinataFiesta_MergedLevel bật thì FiestaLevelCmds.Get() trả
		-- thẳng RaidXP.GetLevel() - tức pinataLevel() CHÍNH LÀ maze level, nên so nó
		-- với mốc 100 là vô nghĩa (log thật: Pinata Level 104.85K = Maze Level).
		-- Giờ đọc thẳng Raid.GetDifficultyLevel() qua mazeLevel().
		if not(CFG.AUTO_UPGRADE and lobby() and Upg and UpgDir and Currency and mazeLevel()>=num("UPGRADE_MIN_MAZE",50000)) then return false end
		local skip={}
		for _,name in ipairs(CFG.UPGRADES or {}) do
			local d=UpgDir[name]
			if type(d)=="table" and d.TierCosts and d.TierPowers and not upgBad[name] then
				local tier=n1(Upg.GetTier,d) or 0
				local cost=d.TierCosts[tier+1]
				local cid=cost and select(2,pcall(cost.GetId,cost))
				local amount=cost and n1(cost.GetAmount,cost)
				if cid and amount and select(2,pcall(Currency.CanAfford,cid,amount)) then
					-- DÙNG KẾT QUẢ SERVER TRẢ VỀ. Purchase là Network.Invoke nên có
					-- (ok, err). CanAfford của client KHÔNG khớp server 100% - log thật:
					--     FiestaSmashSpeed  gia 1.30K FiestaOrbs  du=true
					--     server_err=You can't afford this!
					-- Bản cũ chỉ pcall rồi return true, nên nhịp sau lại chọn ĐÚNG cái
					-- đó, server lại từ chối -> kẹt vĩnh viễn ở một món.
					-- Giờ server từ chối thì đánh dấu bỏ qua và vẫn trả true để nhịp
					-- sau thử MÓN KHÁC. Vẫn đúng 1 remote mỗi tick.
					local ok,res,err=pcall(Upg.Purchase,d)
					if ok and res then
						LOG(("[UPG] MUA %s  tier %d->%d  gia %s %s"):format(name,tier,tier+1,fmt(amount),tostring(cid)))
					else
						upgBad[name]=true
						LOG(("[UPG] BO QUA %s: %s"):format(name,tostring(ok and err or "loi goi")))
					end
					return true
				elseif cid and amount then
					skip[#skip+1]=("%s t%d can %s"):format(name,tier+1,fmt(amount))
				end
			end
		end
		if not upgLogged then upgLogged=true
			LOG("[UPG] xong | thieu tien: "..(#skip>0 and table.concat(skip,", ") or "khong con gi de mua"))
		end
		return false
	end
	local function boost()
		if not(Luck and lobby() and mazeLevel()>=num("UPGRADE_MIN_MAZE",50000)) or select(2,pcall(Luck.IsEnabled))~=true then return false end
		local count=n1(Luck.Count) or 0
		-- Chọn tier CẦN NHẤT (còn ít thời gian nhất), không phải tier đầu danh sách.
		local best,bestLeft,bestCap,bestSecs
		for tier=1,count do
			local left=n1(Luck.GetBoostTime,tier) or 0
			-- "HẾT mới tính là cần": mặc định BOOST_MIN_LEFT = 0, tức chỉ nạp tier đã
			-- cạn hẳn. Đặt số > 0 nếu muốn nạp sớm trước khi hết.
			if left<=num("BOOST_MIN_LEFT",0) then
				local cap=n1(Luck.SpendableCap,tier) or 0
				-- ItemToTime = TimeForUnits: số đơn vị này đổi ra bao nhiêu GIÂY.
				-- cap>=1 KHÔNG đủ để kết luận - log thật: tier 1 còn 395 chỗ trống,
				-- bắn lên server nhận lại "That isn't enough to add any time!".
				local secs=n1(Luck.ItemToTime,tier,cap) or 0
				if cap>=1 and secs>=1 and (not bestLeft or left<bestLeft) then
					best,bestLeft,bestCap,bestSecs=tier,left,cap,secs
				end
			end
		end
		if best then
			LOG(("[BOOST] NAP tier %d  con %ds  nap %s don vi (=%ds)"):format(best,math.floor(bestLeft),fmt(bestCap),math.floor(bestSecs)))
			pcall(Luck.AddBoost,best,bestCap); return true
		end
		if not bstLogged then bstLogged=true; LOG("[BOOST] xong | moi tier deu con thoi gian (> "..num("BOOST_MIN_LEFT",0).."s) hoac khong doi noi 1 giay") end
		return false
	end

