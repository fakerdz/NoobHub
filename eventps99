-- Huge/Titanic/Gargantuan may arrive locked in the saved inventory. Keep only
-- those three classes unlocked through the same remote used by Inventory.
do
	local lastUnlock = {}
	local function unlockSpecialPets()
		if not (PetItem and Net) then return end
		local now = os.clock()
		for _, item in pairs(each(PetItem)) do
			local uid = petMethod(item, "GetUID")
			local special = petMethod(item, "IsHuge") == true
				or petMethod(item, "IsTitanic") == true
				or petMethod(item, "IsGargantuan") == true
			local locked = special and petMethod(item, "IsLocked") == true
			if uid and locked and (not lastUnlock[uid] or now - lastUnlock[uid] >= 5) then
				lastUnlock[uid] = now
				local ok, result = pcall(Net.Invoke, "Locking_SetLocked", uid, false)
				if (not ok or result == false) and PetCmds and type(PetCmds.UnlockByItem) == "function" then
					pcall(PetCmds.UnlockByItem, item)
				end
				invDirty = true
				task.wait(0.15)
			elseif uid and not locked then
				lastUnlock[uid] = nil
			end
		end
	end
	task.spawn(function()
		while alive() do
			pcall(unlockSpecialPets)
			task.wait(2)
		end
	end)
end

