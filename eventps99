	--
	-- CHECK ACTIVE để khỏi spam: Consumable KHÔNG cấp Boost mà cấp EFFECT.
	--     Directory "Consumable | Fiesta Maze Damage Booster":
	--         Tiers = { { Effect = { Tier = 1, Value = 600,
	--                     Type = Effects["Fiesta Maze Damage Booster"] } }, ... }
	-- nên phải hỏi EffectCmds, KHÔNG phải BoostCmds.GetTimer (cái đó đọc
	-- Directory.Boosts, hệ khác, luôn trả 0 cho booster này).
	--     EffectCmds.GetBest(effectDir) -> tier, value ; tier > 0 = đang chạy.
	--
	-- CFG.Consume = { Id = "Fiesta Maze Damage Booster", MinTier = 2 }
	-- hoặc nhiều cái:  CFG.Consume = { {Id=...,MinTier=1}, {Id=...,MinTier=2} }
	-- MinTier là tier của ITEM (I/II/III), không phải rarity hiển thị.
	local consumeAt=-1e9
	local function consumeRows()
		local c=CFG.Consume; if type(c)~="table" then return {} end
		if c.Id~=nil then return {c} end
		return c
	end
	local function effectOn(name)
		if not (Effect and EffectDir) then return false end
		local dir=EffectDir[name]; if not dir then return false end
		local ok,tier=pcall(Effect.GetBest,dir)
		return ok and (tonumber(tier) or 0)>0
	end
	local function booster()
		if not (Consumable and ConsumableItem) or clock()-consumeAt<num("CONSUME_EVERY",10) then return end
		consumeAt=clock()
		for _,row in ipairs(consumeRows()) do
			local id=tostring(row.Id or "")
			local minTier=math.max(1,math.floor(tonumber(row.MinTier) or 1))
			-- Effect trùng tên Consumable trong directory nên tra thẳng bằng Id.
			if id~="" and not effectOn(id) then
				-- Lấy tier THẤP NHẤT còn thoả MinTier: xài cái rẻ trước, để dành cái xịn.
				local best,bestTier
				for _,it in ipairs(each(ConsumableItem)) do
					if select(2,pcall(it.GetId,it))==id then
						local t=tonumber(select(2,pcall(it.GetTier,it))) or 0
						if t>=minTier and (not bestTier or t<bestTier) then best,bestTier=it,t end
					end
				end
				if best then
					pcall(Consumable.Consume,best,1); invDirty=true
					return          -- một lượt một cái, khỏi bắn dồn remote
				end
			end
		end
	end
	-- ══ UPGRADE / BOOST: MỖI LƯỢT ĐÚNG 1 REMOTE ═══════════════════════════════
	-- Trả về true = VỪA bắn một remote (còn việc), false = hết việc.
	-- Nhịp do controller quyết (0.35s), không tự đặt throttle bên trong nữa:
	-- bản cũ chỉ đóng dấu S.upgradeAt ở nhánh KHÔNG mua được, nên khi dư tiền nó
