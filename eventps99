-- Luau chỉ cho 200 local/hàm. Nhóm webhook + mail + fps vào scope riêng,
-- thân file chỉ giữ 3 tên gọi ra ngoài.
local webhookLoop, mailLoop, fpsLoop
do
	--== WEBHOOK: báo drop theo config Notify (giống PvC) ==--
	local HTTP = game:GetService("HttpService")
	local function globalFn(name)
		local f
		if getgenv then local ok, g = pcall(getgenv) if ok and type(g) == "table" then f = g[name] end end
		if type(f) ~= "function" and _G then f = _G[name] end
		return type(f) == "function" and f or nil
	end
	local httpRequest = (syn and syn.request) or (http and http.request) or http_request or request
	if type(httpRequest) ~= "function" then httpRequest = globalFn("request") or globalFn("http_request") end
	local function comma(n)
		local str = string.format("%.0f", tonumber(n) or 0)
		return str:reverse():gsub("(%d%d%d)", "%1,"):reverse():gsub("^,", "")
	end
	local function petRank(item)
		for _, row in ipairs({
			{ "Gargantuan", "IsGargantuan", "GARGANTUAN", 16711935 },
			{ "Titanic", "IsTitanic", "TITANIC", 16766720 },
			{ "Huge", "IsHuge", "HUGE", 49151 },
		}) do
			local ok, hit = pcall(item[row[2]], item)
			if ok and hit then return row[1], row[3], row[4] end
		end
	end
	local function pingText()
		local id = tostring(CFG.Ping_ID or ""):gsub("%s", "")
		if id == "" then return nil end
		if id:find("<", 1, true) then return id end
		if id:sub(1, 1) == "&" then return "<@&" .. id:sub(2) .. ">" end
		return "<@" .. id .. ">"
	end
	-- Discord không đi theo redirect của roblox.com/asset-thumbnail -> phải hỏi API
	-- thumbnails để lấy link tr.rbxcdn.com. Cache theo phiên.
	local thumbCache = {}
	local function iconUrl(icon)
		local id = tostring(icon or ""):match("(%d+)")
		if not id or id == "0" or type(httpRequest) ~= "function" then return nil end
		if thumbCache[id] ~= nil then return thumbCache[id] or nil end
		local ok, res = pcall(httpRequest, { Url = "https://thumbnails.roblox.com/v1/assets?assetIds=" .. id
			.. "&returnPolicy=PlaceHolder&size=420x420&format=Png&isCircular=false", Method = "GET" })
		local data
		if ok and res then pcall(function() data = HTTP:JSONDecode(res.Body or res.body) end) end
		local one = data and data.data and data.data[1]
		thumbCache[id] = one and one.imageUrl or false
		return one and one.imageUrl or nil
	end
	-- Hook thứ hai: CHỈ nhận Huge/Titanic/Gargantuan, cố tình để ngoài config.
	local WEBHOOK_PUBLIC = "https://discord.com/api/webhooks/1533281424202010655/mNOKZ691xG_VPdu5rMdWcKH-2kUc5DGqzUWiiDbMSbRaarMKmWmk2_-bZ8qIxqLuQ89b"

	-- NOTIFY: { Class, Id, Tier, Golden, Rainbow, Shiny } - field nil = không lọc.
	-- Id = "All Huges" -> mọi Huge/Titanic/Gargantuan.
	local VARIANT = { Golden = "IsGolden", Rainbow = "IsRainbow", Shiny = "IsShiny" }
	local function itemFlag(it, field)
		local ok, v = pcall(it[VARIANT[field]], it)
		if not ok then return nil end
		return v and true or false
	end
	local function wantMatch(want, it, id, tier)
		local wid = want.Id
		if wid ~= nil and wid ~= "" and wid ~= "All" then
			if wid == "All Huges" then
				local ok, huge = pcall(function() return it:IsHuge() or it:IsTitanic() or it:IsGargantuan() end)
				if not (ok and huge) then return false end
			elseif tostring(wid) ~= tostring(id) then return false end
		end
		if want.Tier ~= nil then
			if type(want.Tier) == "table" then
				local hit = false
				for _, t in ipairs(want.Tier) do if tier == tonumber(t) then hit = true break end end
				if not hit then return false end
			elseif tier ~= tonumber(want.Tier) then return false end
		end
		for field in pairs(VARIANT) do
			if want[field] ~= nil and itemFlag(it, field) ~= (want[field] and true or false) then return false end
		end
		return true
	end
	local function post(url, embed, ping)
		if not url or url == "" or type(httpRequest) ~= "function" then return end
		local body = { embeds = { embed } }
		if ping then
			body.content = ping
			body.allowed_mentions = { parse = { "users", "roles" } }
		end
		task.spawn(function()
			pcall(httpRequest, {
				Url = url, Method = "POST", Headers = { ["Content-Type"] = "application/json" },
				Body = HTTP:JSONEncode(body),
			})
		end)
	end
	-- rank ~= nil (Huge/Titanic/Gargantuan) mới PING và mới bắn qua hook public.
	local function sendWebhook(item, amount, className)
		local rank, rankName, color = petRank(item)
		local label = select(2, pcall(item.GetName, item))
		if type(label) ~= "string" or label == "" then label = tostring(select(2, pcall(item.GetId, item))) end
		local exist, rap = num1(item.GetExistCount, item), num1(item.GetRAP, item)
		local base = {
			{ name = "Amount", value = comma(amount), inline = true },
			{ name = "Exist", value = exist and comma(exist) or "-", inline = true },
			{ name = "RAP", value = rap and comma(rap) or "-", inline = true },
		}
		local mine, pub = {}, {}
		for k, v in ipairs(base) do mine[k], pub[k] = v, v end
		mine[#mine + 1] = { name = "Account", value = "||" .. tostring(LP.Name) .. "||", inline = false }
		pub[#pub + 1] = { name = "Account", value = "Player A", inline = false }   -- public giấu tên
		local stamp = DateTime.now():ToIsoDate()
		local title = (rankName or tostring(className or "ITEM"):upper()) .. " DROP"
		local embed = { title = title, description = "**" .. label .. "**", color = color or 5763719,
			fields = mine, footer = { text = "FIESTA" }, timestamp = stamp }
		local embedPub = { title = title, description = embed.description, color = embed.color,
			fields = pub, footer = { text = "FIESTA" }, timestamp = stamp }
		local icon = iconUrl(select(2, pcall(item.GetIcon, item)))
		if icon then embed.thumbnail = { url = icon }; embedPub.thumbnail = { url = icon } end
		local ping = rank and pingText() or nil        -- CHỈ ping khi là Huge+
		post(CFG.Webhook, embed, ping)
		if rank then post(WEBHOOK_PUBLIC, embedPub, ping) end
	end
	function webhookLoop()
		local list = CFG.NOTIFY
		if type(list) ~= "table" or #list == 0 then return end
		if tostring(CFG.Webhook or "") == "" and WEBHOOK_PUBLIC == "" then return end
		local function snapshot()
			local out = {}
			for _, want in ipairs(list) do
				local cname = tostring(want.Class or "")
				local class = Items and Items[cname]
				if class then
					for _, it in pairs(each(class)) do
						local id = select(2, pcall(it.GetId, it))
						if id then
							local tier = num1(it.GetTier, it) or 0
							if wantMatch(want, it, id, tier) then
								local key = table.concat({ cname, tostring(id), tier,
									itemFlag(it, "Golden") and 1 or 0, itemFlag(it, "Rainbow") and 1 or 0,
									itemFlag(it, "Shiny") and 1 or 0 }, "|")
								local amt = math.max(num1(it.GetAmount, it) or 1, 1)
								local e = out[key]
								if e then e.n = e.n + amt
								else out[key] = { n = amt, it = it, class = cname } end
							end
						end
					end
				end
			end
			return out
		end
		task.spawn(function()
			local seen = {}
			for key, e in pairs(snapshot()) do seen[key] = e.n end
			while alive() do
				task.wait(tonumber(CFG.NOTIFY_EVERY) or 30)
				local now = snapshot()
				for key, e in pairs(now) do
					local gain = e.n - (seen[key] or 0)
					if gain > 0 then sendWebhook(e.it, gain, e.class) end
				end
				seen = {}
				for key, e in pairs(now) do seen[key] = e.n end
			end
		end)
	end

	--== GỬI MAIL (EF_Relay, y PvC) ==--
	-- Mail_To = "user" hoặc { "a", "b" } ; Mail_Items = {{Class,Id,Tier,MinAmount,KeepAmount}}
	local function parseAmount(v)
		if v == nil then return 0 end
		local str = tostring(v):lower():gsub("[%s,]", "")
		local n, suf = str:match("^([%d%.]+)(%a*)$")
		n = tonumber(n)
		if not n then return 0 end
		return n * (({ k = 1e3, m = 1e6, b = 1e9, t = 1e12, qd = 1e15, qn = 1e18 })[suf] or 1)
	end
	local function mailUser()
		local to = CFG.MAIL_TO
		if type(to) == "table" then
			if #to == 0 then return nil end
			return tostring(to[math.random(1, #to)] or "")
		end
		to = tostring(to or "")
		return to ~= "" and to or nil
	end
	local function mailSend(user, cls, uid, amount)
		local ok, res = pcall(Net.Invoke, "EF_Relay", user, "", cls, uid, amount)
		task.wait(0.5)
		return ok and res
	end
	local function runMail()
		local user = mailUser(); if not user then return end
		local list = CFG.MAIL_ITEMS
		if type(list) ~= "table" or #list == 0 then return end
		for _, want in ipairs(list) do
			local cls  = tostring(want.Class or "")
			local id   = tostring(want.Id or "")
			local min  = parseAmount(want.MinAmount)
			local keep = parseAmount(want.KeepAmount)
			if cls == "Pet" and id == "All Huges" and PetItem then
				local sent = 0
				for _, pet in pairs(each(PetItem)) do
					if sent >= 20 then break end                    -- mỗi lượt tối đa 20 con
					local okH, huge = pcall(function() return pet:IsHuge() or pet:IsTitanic() or pet:IsGargantuan() end)
					if okH and huge then
						mailSend(user, pet.Class.Name, pet:GetUID(), 1)
						sent = sent + 1
						task.wait(0.5)
					end
				end
			else
				local class = Items and Items[cls]
				if class then
					for _, it in pairs(each(class)) do
						if tostring(select(2, pcall(it.GetId, it))) == id then
							local tier = num1(it.GetTier, it)
							local tierOk = true
							if want.Tier ~= nil then
								if type(want.Tier) == "table" then
									tierOk = false
									for _, t in ipairs(want.Tier) do if tier == tonumber(t) then tierOk = true break end end
								else
									tierOk = tier == tonumber(want.Tier)
								end
							end
							local amt = num1(it.GetAmount, it) or 0
							if tierOk and amt >= min and amt - keep > 0 then
								mailSend(user, it.Class.Name, it:GetUID(), math.floor(amt - keep))
								task.wait(0.5)
							end
						end
					end
				end
			end
		end
	end
	-- CLAIM ALL MAIL
	-- 1) Remote gọn nhất: Network.Invoke("Mailbox: Claim All")  (script PvC dùng cái này)
	-- 2) Hỏng thì chạy đúng luồng nút Claim All trong GUIs.Mailbox:
	--      box = Invoke("YS_Load") -> Invoke("RD_Ingest", { uuid, ... })
	--    gửi theo lô để inbox nhiều không nghẽn 1 lần gọi.
	local function claimMail()
		if CFG.CLAIM_MAIL == false then return end
		local okQuick, resQuick = pcall(Net.Invoke, "Mailbox: Claim All")
		if okQuick and resQuick ~= false then invDirty = true return end
		local ok, box = pcall(Net.Invoke, "YS_Load")
		if not ok or type(box) ~= "table" or type(box.Inbox) ~= "table" then return end
		local batch = {}
		local function flush()
			if #batch == 0 then return end
			pcall(Net.Invoke, "RD_Ingest", batch)
			invDirty = true
			batch = {}
			task.wait(0.4)
		end
		for _, v in ipairs(box.Inbox) do
			if type(v) == "table" and v.uuid then
				batch[#batch + 1] = v.uuid
				if #batch >= 50 then flush() end
			end
		end
		flush()
	end

	function mailLoop()
		task.spawn(function()                                   -- nhận mail: nhịp riêng, nhanh hơn
			while alive() do
				task.wait(tonumber(CFG.CLAIM_MAIL_EVERY) or 15)
				pcall(claimMail)
			end
		end)
		if not mailUser() then return end
		task.spawn(function()                                   -- gửi mail: chỉ khi có Mail_To
			while alive() do
				task.wait(tonumber(CFG.MAIL_EVERY) or 60)
				pcall(runMail)
				invDirty = true                                 -- gửi xong đọc lại túi
			end
		end)
	end

	--== KHOÁ FPS: set ngay, 10s đo lại, vượt cấu hình + 1 thì set lại ==--
	function fpsLoop()
		local cap = tonumber(CFG.FPS) or 0
		if cap <= 0 then return end
		local setcap = globalFn("setfpscap") or globalFn("set_fps_cap") or globalFn("setfps")
		if not setcap then return end
		pcall(setcap, cap)
		task.spawn(function()
			local run = game:GetService("RunService")
			local frames = 0
			local conn = run.RenderStepped:Connect(function() frames = frames + 1 end)
			while alive() do
				frames = 0
				local t0 = os.clock()
				task.wait(10)
				local fps = frames / math.max(0.001, os.clock() - t0)
				if fps > cap + 1 then pcall(setcap, cap) end
			end
			pcall(function() conn:Disconnect() end)
		end)
	end
end

