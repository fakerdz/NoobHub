-- Rủi ro nhất nên để cuối. Nhường allowlist + cây Breakables/Random Events, và
-- CHỪA THÊM mọi script có tên chứa Fiesta/Pinata/Maze/Raid/Instance vì mode
-- challenge + raid + eternal đều dựa vào chúng.
local KILLED = {}
local FIESTA_WORDS = { "Fiesta", "Pinata", "Maze", "Raid", "Instance", "Eternal" }
local function isFiestaScript(full)
	for _, w in ipairs(FIESTA_WORDS) do if string.find(full, w, 1, true) then return true end end
	return false
end
local function stopScript(o)
	if not o:IsA("LocalScript") or o.Disabled then return end
	local full = o:GetFullName()
	if inKeep(full) or isFiestaScript(full) then return end
	local p, inScripts = o.Parent, false
	while p and p ~= PS do
		if p.Name == "Breakables" or p.Name == "Random Events" then return end
		if p.Name == "Scripts" or p.Name == "Parallel Pet Actors" then inScripts = true end
		p = p.Parent
	end
	if not inScripts and o.Name ~= "RbxCharacterSounds" then return end
	if pcall(function() o.Disabled = true end) then
		R.script += 1
		-- FP_DebugScripts = true: in ra ĐÚNG tên đã tắt. Nghi tắt oan cái gì thì bật
		-- lên đọc, đừng đoán.
		if on("FP_DebugScripts", false) then KILLED[#KILLED + 1] = o.Name end
	end
end
if on("FP_StopScripts", true) then
	-- GetDescendants MỘT LẦN lúc boot: không có cách khác để thấy hết script, và
	-- nó không lặp lại. Sau đó chỉ dựa vào sự kiện.
	for _, o in ipairs(PS:GetDescendants()) do stopScript(o) end
	reg("psAdded", PS.DescendantAdded, stopScript)
end

