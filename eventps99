	-- Đi Rooms › <bất kỳ> › BREAK_ZONES › BasePart. Không lọc tên phòng: Rooms
	-- chứa lẫn Boss1..n, Room1..n, Gate_*, Preview_*, Checkerboard, Perimeter -
	-- cái nào không có BREAK_ZONES thì tự rụng.
	-- position=nil -> chỉ đếm, không tính khoảng cách.
	local function scanBreakZones(position)
		local ok,model=pcall(Inst.GetModel)
		if not ok or typeof(model)~="Instance" then return nil,nil,0 end
		local rooms=model:FindFirstChild("Rooms"); if not rooms then return nil,nil,0 end
		local best,bestDist,n=nil,nil,0
		local function eat(bz)
			for _,part in ipairs(bz:GetChildren()) do
				if part:IsA("BasePart") then
					n=n+1
					if position then
						local d=(part.Position-position).Magnitude
						if not bestDist or d<bestDist then best,bestDist=part,d end
					end
				end
			end
		end
		for _,room in ipairs(rooms:GetChildren()) do
			if room.Name=="BREAK_ZONES" then eat(room)
			else local bz=room:FindFirstChild("BREAK_ZONES"); if bz then eat(bz) end end
		end
		return best,bestDist,n
	end
	-- Trong maze mà CHƯA có zone nào = phòng chưa dựng xong. Mọi logic đứng chờ.
	-- Ngoài maze thì KHÔNG chặn - lobby không có Rooms, chặn ở đó là treo cả bot.
	-- Cache 0.25s: hàm này bị hỏi ở nhịp 0.35s, khỏi duyệt cây mỗi lần.
	local zrAt,zrVal=-1e9,false
