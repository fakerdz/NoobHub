	local function killGcWorkers()
		if LG.SAFE_MODE >= 1 then return 0 end
		local getGc = gfn("getgc")
		if not getGc then return 0 end
		local ok, objects = pcall(getGc, true)
		if not ok or type(objects) ~= "table" then return 0 end
		local killed = 0
		for _, object in pairs(objects) do
			if type(object) == "thread" then
				local okSource, source = pcall(function() return debug.info(object, 1, "s") end)
				if okSource and type(source) == "string" then
					local keep = false
					for _, safe in ipairs(K.GC_KEEP_SOURCE) do if string.find(source, safe, 1, true) then keep = true break end end
					local kill = false
					if not keep then for _, wanted in ipairs(K.GC_KILL_SOURCE) do if string.find(source, wanted, 1, true) then kill = true break end end end
					if kill and pcall(task.cancel, object) then killed = killed + 1 end
				end
			end
		end
		return killed
	end
	local function killRenderConnections()
		if LG.SAFE_MODE >= 1 then return 0 end
		local getConnections = gfn("getconnections")
		if not getConnections then return 0 end
		local run = game:GetService("RunService")
		local killed = 0
		for _, signal in ipairs({ run.RenderStepped, run.Heartbeat, run.Stepped, run.PreSimulation, run.PostSimulation, run.PreRender }) do
			local ok, list = pcall(getConnections, signal)
			if ok and type(list) == "table" then
				for _, connection in ipairs(list) do
					local okSource, source = pcall(function() return debug.info(connection.Function, "s") end)
					if okSource and type(source) == "string" then
						local keep = false
						for _, safe in ipairs(K.GC_KEEP_SOURCE) do if string.find(source, safe, 1, true) then keep = true break end end
						if not keep then
							for _, wanted in ipairs(K.GC_KILL_SOURCE) do
								if string.find(source, wanted, 1, true) then
									local done = pcall(function() connection:Disable() end)
									if not done then done = pcall(function() connection:Disconnect() end) end
									if done then killed = killed + 1 end
									break
								end
							end
						end
					end
				end
			end
		end
		return killed
	end

