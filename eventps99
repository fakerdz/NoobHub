-- Tra ve true CHI khi da claim/settle HET chest (chua het -> false de vong sau claim lai).
local function claimEggs()
	if not (CFG.CLAIM_EGG and Portals) then return true end   -- tat claim -> coi nhu xong
	if not inMaze() then return true end
	pcall(function() Portals.SendToPrizeRoom() end)
	local ct
