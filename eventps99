	-- Stub_Hard=false -> bản hiền: chỉ ẩn, không Destroy, không đổi vật lý.
	local function compactBreakable(model)
		if CFG.STUB_COMPACT==false or CFG.STUB_BREAKABLE==false or not model or not model:IsA("Model") then return end
		local part=model.PrimaryPart
		if not part or not part:IsA("BasePart") then return end
		if CFG.STUB_HARD~=false then
			pcall(function()
				for _,c in ipairs(model:GetChildren()) do if c~=part then c:Destroy() end end
				for _,c in ipairs(part:GetChildren()) do c:Destroy() end
				part.Transparency,part.Size,part.Anchored,part.Massless=1,Vector3.new(1,1,1),true,true
				part.CanCollide,part.CanTouch,part.CanQuery,part.CastShadow=false,false,false,false
			end)
			return
		end
		pcall(function()
			part.Transparency,part.CastShadow=1,false
			-- Ba thứ dưới đây ĐỀU là sửa vật lý của part server sở hữu, mặc định
			-- TẮT. Bật từng cái một để biết server chịu được tới đâu - đừng bật
