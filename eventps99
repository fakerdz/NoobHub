	local function pickPortal()
		local r=root(); local best,bestD
		for _,x in ipairs(game:GetService("CollectionService"):GetTagged("RaidPortal")) do
			local n=tonumber(x.Name); local q=x:IsA("BasePart") and x or x.PrimaryPart
