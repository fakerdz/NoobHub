local INV, invDirty, invAt = {}, true, 0
pcall(function() Net.Fired("Items: Update"):Connect(function() invDirty = true end) end)
-- pcall trả (ok, v1, v2, ...). tonumber(select(2, pcall(f))) sẽ thành
-- tonumber(v1, v2) -> "invalid argument #2 to 'tonumber' (base out of range)"
-- khi hàm trả nhiều giá trị (vd GetPotionData trả tier, timeLeft). Luôn dùng num1.
local function num1(fn, ...)
	local ok, v = pcall(fn, ...)
	return ok and tonumber(v) or nil
end
local function each(cls)
	local t = os.clock()
	if invDirty or t - invAt > 5 then table.clear(INV); invDirty, invAt = false, t end
	local hit = INV[cls]
	if hit then return hit end
	local r = select(2, pcall(function() return cls and cls:All() end)) or {}
	INV[cls] = r
	return r
end

-- AutoWorldRank buffs: keep the configured highest usable tier active.
-- Mỗi mục trong CFG.Enchant = 1 SLOT, kể cả trùng tên ({"Criticals","Criticals"}
-- = 2 slot Criticals). Khai thiếu thì để trống slot, không tự lấp bừa.
-- Bug cũ: gom list thành SET nên trùng tên bị nuốt, và mấy cây đang đeo trùng
-- loại vẫn được giữ -> chiếm hết slot, tên phía sau (vd Super Lightning) hết chỗ.
-- Mỗi mục trong CFG.Enchant = 1 SLOT (trùng tên = nhiều slot). Khai thiếu -> để
-- trống. Với mỗi loại, luôn giữ đúng N cây TIER CAO NHẤT dùng được: đang đeo cây
-- yếu hơn cây trong túi thì tháo ra thay, loại không có trong cfg thì tháo hẳn.
local function runEnchant()
	local list = CFG.Enchant
	if type(list) ~= "table" or #list == 0 or not (EnchantCmds and EnchantItem and Mastery) then return end
	local slots = num1(EnchantCmds.GetMaxEquippedEnchants) or 0
	if slots <= 0 then return end

	local want = {}                                   -- id -> cần mấy cây (cắt theo slot)
	for k = 1, math.min(#list, slots) do
		local id = tostring(list[k] or "")
		if id ~= "" then want[id] = (want[id] or 0) + 1 end
	end

	-- EnchantCmds.Get(id) trả CẢ cây đang đeo -> chọn top-N tier cao nhất là ra
	-- luôn tập đích, khỏi phân biệt đeo/chưa đeo.
	local target = {}                                 -- uid -> true (bộ cần đeo)
	for id, need in pairs(want) do
		local pool = {}
		for uid, item in pairs(select(2, pcall(EnchantCmds.Get, id)) or {}) do
			local tier = num1(item.GetTier, item) or 0
			local ok, can = pcall(Mastery.CanUseEnchant, tier)
			if ok and can then pool[#pool + 1] = { uid = uid, tier = tier } end
		end
		table.sort(pool, function(a, b) return a.tier > b.tier end)
		for k = 1, math.min(need, #pool) do target[pool[k].uid] = true end
	end

	-- tháo: không thuộc tập đích (sai loại, dư số lượng, hoặc tier thấp hơn)
	local equipped = select(2, pcall(EnchantCmds.GetEquipped)) or {}
	for slot, uid in pairs(equipped) do
		if target[uid] then
			target[uid] = nil                          -- đã đeo đúng cây rồi
		else
			pcall(EnchantCmds.Unequip, tonumber(slot) or slot)
			task.wait(0.2)
		end
	end
	-- đeo phần còn thiếu
	for uid in pairs(target) do
		pcall(EnchantCmds.Equip, uid)
		task.wait(0.2)
	end
end

local function pickPotion(id)
	local best, bestTier
	for _, item in pairs(each(PotionItem)) do
		local iid = select(2, pcall(item.GetId, item))
		local amount = num1(item.GetAmount, item) or 0
		if tostring(iid) == tostring(id) and amount > 0 then
			local tier = num1(item.GetTier, item) or 1
			local ok = select(2, pcall(Mastery.CanUsePotion, tier))
			if ok and (not bestTier or tier > bestTier) then best, bestTier = item, tier end
		end
	end
	return best, bestTier
end

local function runPotion()
	local list = CFG.Potion
	if type(list) ~= "table" or #list == 0 then return end
	if not (PotionCmds and PotionItem and Mastery) then return end
	for _, name in ipairs(list) do
		local id = tostring(name or "")
		if id ~= "" then
			-- item = chai tier CAO NHẤT dùng được; active = tier đang chạy
			local item, tier = pickPotion(id)
			local active = num1(PotionCmds.GetPotionData, id) or 0
			if item and tier and (active <= 0 or tier > active) then
				pcall(PotionCmds.Consume, select(2, pcall(item.GetUID, item)), 1)
				invDirty = true
				task.wait(0.3)
			end
		end
	end
end

