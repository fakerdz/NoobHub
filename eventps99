--== CHECK KEY (NOOB HUB) — y logic PvC ==--
-- Khai trước khi chạy: script_key = "..."  |  script_product_id = "..."
do
	local HTTPk = game:GetService("HttpService")
	local LPk = game:GetService("Players").LocalPlayer
	local function gvar(name)                 -- loader khai global trần -> dò 3 chỗ
		local v
		if getgenv then local ok, g = pcall(getgenv) if ok and type(g) == "table" then v = rawget(g, name) end end
		if v == nil and getfenv then local ok, e = pcall(getfenv, 0) if ok and type(e) == "table" then v = rawget(e, name) end end
		if v == nil and _G then v = rawget(_G, name) end
		return v
	end
	local req_ = (syn and syn.request) or (http and http.request) or http_request or request
	local function kick(reason)
		pcall(function() LPk:Kick(tostring(reason or "[NOOB HUB] Invalid Key")) end)
		task.wait(9e9)
	end
	local key = tostring(gvar("script_key") or ""):gsub("^%s+", ""):gsub("%s+$", "")
	local pid = tostring(gvar("script_product_id") or ""):gsub("^%s+", ""):gsub("%s+$", ""):upper()
	if key == "" or pid == "" then kick("[NOOB HUB] Invalid Key") end
	if type(req_) ~= "function" then kick("[NOOB HUB] Cant Connect") end
	local function ask()
		local body = {
			username = LPk.Name, placeid = game.PlaceId, jobid = game.JobId,
			idroblox = LPk.UserId, key = key, product_id = pid, token = "thuankia213",
		}
		local hw = gvar("gethwid") or gvar("get_hwid")
		if type(hw) == "function" then
			local okH, v = pcall(hw)
			if okH and v then body.hwid = tostring(v) end
		end
		local ok, res = pcall(req_, {
			Url = "https://api.noobhub.click/checkkey", Method = "POST",
			Headers = { ["Content-Type"] = "application/json", ["Accept"] = "application/json" },
			Body = HTTPk:JSONEncode(body),
		})
		if not ok or not res then return false, 0 end
		local code = tonumber(res.StatusCode or res.status_code or res.Status or res.status or 0) or 0
		local data; pcall(function() data = HTTPk:JSONDecode(tostring(res.Body or res.body or "")) end)
		return true, code, data
	end
	local ok, code, data = ask()
	if not ok then kick("[NOOB HUB] Cant Connect") end
	if not (code == 200 and data and data.ok == true) then
		local why = data and tostring(data.reason or data.error or "") or ""
		kick(why ~= "" and why or "[NOOB HUB] Invalid Key")
	end
	task.spawn(function()                     -- 20s kiểm lại, hụt 3 lần liên tiếp thì kick
		local miss = 0
		while true do
			task.wait(20)
			local okL, codeL, dataL = ask()
			if okL and codeL == 200 and dataL and dataL.ok == true then miss = 0
			elseif okL and codeL == 403 then
				local why = dataL and tostring(dataL.reason or dataL.error or "") or ""
				kick(why ~= "" and why or "[NOOB HUB] Invalid Key") return
			else
				miss = miss + 1
				if miss >= 3 then kick("[NOOB HUB] Cant Connect") return end
	end
	end
end)
end

