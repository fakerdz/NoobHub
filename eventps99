		-- Mỗi mục trong CFG.Enchant = 1 SLOT, TRÙNG TÊN = NHIỀU SLOT
		-- ({"Criticals","Criticals"} = 2 slot Criticals). Cắt danh sách theo
		-- GetMaxEquippedEnchants, thừa thì bỏ.
		--
		-- Bản cũ ở đây chỉ biết ĐEO, không bao giờ THÁO -> cây đang đeo sẵn (sai
		-- loại, hoặc tier thấp hơn cây trong túi) chiếm hết slot, mấy tên đứng
		-- cuối danh sách không bao giờ lên được. Đó là bug Fiesta_All đã sửa.
		--
		-- Gốc dùng task.wait(0.2) giữa các thao tác. Ở đây MỘT LUỒNG duy nhất nên
		-- không được wait: mỗi nhịp làm ĐÚNG MỘT thao tác rồi return, nhịp sau
		-- (items = 12s) tính lại từ đầu. Chậm hơn nhưng không treo scheduler.
		if Enchant and EnchantItem and Mastery and type(CFG.Enchant)=="table" and #CFG.Enchant>0 then
			local slots=n1(Enchant.GetMaxEquippedEnchants) or 0
			if slots>0 then
				local want={}                                   -- tên -> cần mấy cây
				for k=1,math.min(#CFG.Enchant,slots) do
					local nm=tostring(CFG.Enchant[k] or "")
					if nm~="" then want[nm]=(want[nm] or 0)+1 end
				end
				-- Get(tên) trả CẢ cây đang đeo, nên lấy top-N tier cao nhất là ra
				-- luôn tập đích, khỏi phân biệt đeo hay chưa.
				local target={}
				for nm,need in pairs(want) do
					local pool={}
					for uid,it in pairs(select(2,pcall(Enchant.Get,nm)) or {}) do
						local tier=n1(it.GetTier,it) or 0
						if select(2,pcall(Mastery.CanUseEnchant,tier)) then pool[#pool+1]={uid=uid,tier=tier} end
					end
					table.sort(pool,function(a,b) return a.tier>b.tier end)
					for k=1,math.min(need,#pool) do target[pool[k].uid]=true end
				end
				-- THÁO trước: sai loại, dư số lượng, hoặc tier thấp hơn cây trong túi
				local equipped=select(2,pcall(Enchant.GetEquipped)) or {}
				for slot,uid in pairs(equipped) do
					if target[uid] then target[uid]=nil
					else pcall(Enchant.Unequip,tonumber(slot) or slot); return end
				end
				-- rồi mới ĐEO phần còn thiếu
				for uid in pairs(target) do pcall(Enchant.Equip,uid); return end
			end
		end
		if Buff and MiscItem and CFG.Toy~=false then local toys={["Toy Ball"]="ToyBall_Consume",["Toy Bone"]="ToyBone_Consume",["Squeaky Toy"]="SqueakyToy_Consume"}; for _,it in pairs(each(MiscItem)) do local id=tostring(select(2,pcall(it.GetId,it))); local r=toys[id]; if r and (n1(Buff.GetTimer,id) or 0)<=0 and (n1(it.GetAmount,it) or 0)>0 then invoke(r,1); return end end end
	end
