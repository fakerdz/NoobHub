	local function buildHud()
		local UIS = game:GetService("UserInputService")
		local Tween = game:GetService("TweenService")
		local FiestaCredits = req("Util.FiestaCredits")
		local Save = req("Client.Save")
		local ItemMods = { Pet = PetItem, Potion = PotionItem, Fruit = FruitItem, Misc = MiscItem, Lootbox = LootboxItem }
		local SUF = { "", "K", "M", "B", "T", "Qa", "Qi", "Sx", "Sp", "Oc", "No", "Dc" }
		local function short(n)
			n = tonumber(n) or 0
			local i = 1
			while math.abs(n) >= 1000 and i < #SUF do n, i = n / 1000, i + 1 end
			return i == 1 and tostring(math.floor(n)) or string.format("%.2f%s", n, SUF[i])
		end
		local function curAmt(cid)
			local ok, value = pcall(Currency and Currency.Get, cid)
			return ok and tonumber(value) or 0
		end
		local SHORT = { FiestaDamage = "Damage", FiestaSmashSpeed = "Speed", FiestaPets = "Pets", FiestaKeyDrops = "Keys", FiestaBetterLoot = "Loot", FiestaMoreCurrency = "Coins+", FiestaXP = "XP" }
		local function upgList()
			local out = {}
			for _, id in ipairs(type(CFG.UPGRADES) == "table" and CFG.UPGRADES or {}) do
				local dir = UpgDir and UpgDir[id]
				if type(dir) == "table" and dir.TierPowers then
					local tier = n1(Upg and Upg.GetTier, dir) or 0
					out[#out + 1] = { icon = dir.Icon, tier = tier, max = #dir.TierPowers, name = SHORT[id] or id }
				end
			end
			return out
		end
		local function equipList()
			local grouped, total = {}, 0
			local equipped = Pet and select(2, pcall(Pet.GetEquippedItems)) or {}
			for _, it in pairs(equipped or {}) do
				local id = tostring(select(2, pcall(function() return it:GetId() end)))
				local row = grouped[id]
				if row then row.count = row.count + 1 else grouped[id] = { id = id, count = 1, icon = select(2, pcall(function() return it:GetIcon() end)) } end
				total = total + 1
			end
			local out = {}
			for _, row in pairs(grouped) do out[#out + 1] = row end
			table.sort(out, function(a, b) return a.count > b.count end)
