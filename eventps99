	"InventoryNotifications","FreeGiftsRedeemed","FreeGiftsResetTime",
}
local Save, BF
local function pruneEvent(ev, wipeAll)
	local list = type(ev) == "table" and rawget(ev, "_list")
	if type(list) ~= "table" then return end
	for i = #list, 1, -1 do
		local c = list[i]
		local kill = wipeAll
		if not kill then
			local fn = rawget(c, "_fn")
			local s = type(fn) == "function" and srcOf(fn) or nil
			kill = s ~= nil and isGame(s) and not inKeep(s)
		end
		if kill and pcall(function() c:Disconnect() end) then R.listener += 1 end
	end
end
local function pruneStats()
	if not Save then return end
	-- stat của NGƯỜI KHÁC: logic Fiesta không đọc bao giờ. Server đông người thì
	-- hai cái này bắn liên tục. Dọn sạch, khỏi lọc.
	pruneEvent(Save.OtherStatChanged, true)
	pruneEvent(Save.OtherStatsChanged, true)
	pruneEvent(Save.StatChanged, false)
	pruneEvent(Save.StatsChanged, false)
	if type(Save.GetStatChangedSignal) == "function" then
		for _, n in ipairs(STATS) do
