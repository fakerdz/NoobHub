-- ── quét connection mỗi frame ─────────────────────────────────────────────
-- CHẶN MẶC ĐỊNH, chỉ trên RenderStepped.
-- CỐ TÌNH không mở sang Heartbeat: Functions.DistanceHeartbeat và
-- Functions.Heartbeat tạo closure NGAY TRONG module wrapper, nên debug.info trả
-- về đường dẫn wrapper chứ không phải bên gọi -> lọc theo nguồn là cắt bừa.
local function sweepFrames()
	local getconn = gfn("getconnections")
	if not getconn then return end
	local ok, list = pcall(getconn, Run.RenderStepped)
	if not ok or type(list) ~= "table" then return end
	for _, c in ipairs(list) do
		local okf, fn = pcall(function() return c.Function end)
		if okf and type(fn) == "function" then
			local s = srcOf(fn)
			if s and isGame(s) and not inKeep(s) and not isFiestaScript(s) then
				local done = pcall(function() c:Disable() end)
				if not done then done = pcall(function() c:Disconnect() end) end
				if done then R.frame += 1 end
			end
		end
	end
end

-- ── huỷ luồng nền của tính năng không dùng ────────────────────────────────
-- 59 vòng `while task.wait()` trong ModuleScript, chạy bằng task.spawn lúc
-- require: không phải LocalScript (Disabled vô dụng), không phải connection
-- (getconnections vô dụng). Chỉ getgc + task.cancel tới được.
-- Nặng nhất: EventFishingCmds - 9 vòng lặp cho sự kiện câu cá.
local DEAD = {
	"EventFishingCmds","TowerDefense","BoatCmds","DigsiteCmds","BlockParty","TapHeroes",
	"HugePartyUtil","XmasLockCmds","WingsCmds","BoothCmds","CustomCard","ToolCmds",
	"PlotCmds","FarmHoldCmds","GardenCmds",
}
local killed = 0
local function killIdleThreads()
	local gc = gfn("getgc"); if not gc then return end
	local ok, objs = pcall(gc, true)
	if not ok or type(objs) ~= "table" then return end
	for _, o in pairs(objs) do
		if type(o) == "thread" and coroutine.status(o) == "suspended" then
			for lvl = 0, 3 do
				local oks, s = pcall(debug.info, o, lvl, "s")
				if not oks or type(s) ~= "string" or s == "" then break end
				if not inKeep(s) and not isFiestaScript(s) then
					for _, w in ipairs(DEAD) do
						if string.find(s, w, 1, true) then
							if pcall(task.cancel, o) then killed += 1 end
							break
						end
					end
				end
			end
		end
	end
end

