		end
		local function ruleMatch(want, it)
			local id = select(2, pcall(function() return it:GetId() end))
			local wanted = want.Id
			if wanted and wanted ~= "" and wanted ~= "All" then
				if wanted == "All Huges" then
					local huge = select(2, pcall(function() return it:IsHuge() or it:IsTitanic() or it:IsGargantuan() end))
					if not huge then return false end
				elseif tostring(wanted) ~= tostring(id) then return false end
				end
			if want.Tier ~= nil and (tonumber(select(2, pcall(function() return it:GetTier() end))) or 0) ~= tonumber(want.Tier) then return false end
			return true, tostring(id)
