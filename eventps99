	-- parseAmount: MinAmount/KeepAmount nhận "10k", "1.5m", "2 b"... chứ không
	-- chỉ số trần. Gốc có, bản cũ ở đây thiếu -> khai "10k" ra nil -> gửi sạch.
	local function parseAmount(v)
		if v==nil then return 0 end
		local str=tostring(v):lower():gsub("[%s,]","")
		local n,suf=str:match("^([%d%.]+)(%a*)$"); n=tonumber(n)
		if not n then return 0 end
		return n*(({k=1e3,m=1e6,b=1e9,t=1e12,qd=1e15,qn=1e18})[suf] or 1)
	end
	-- NHẬN MAIL: bắn remote gọn trước, ĐỌC kết quả. Hỏng thì đi đúng luồng nút
	-- Claim All: YS_Load lấy inbox -> RD_Ingest theo lô 50 uuid.
	-- Bản cũ chỉ bắn một phát rồi thôi, không biết mình vừa thất bại.
	-- Một luồng nên không task.wait giữa các lô: mỗi nhịp gửi MỘT lô rồi return.
	local function claimMail()
		if CFG.CLAIM_MAIL==false then return false end
		local ok,res=invoke("Mailbox: Claim All")
		if ok and res~=false then invDirty=true; return false end
		local okBox,box=pcall(N.Invoke,"YS_Load")
		if not okBox or type(box)~="table" or type(box.Inbox)~="table" then return false end
		local batch={}
		for _,v in ipairs(box.Inbox) do
			if type(v)=="table" and v.uuid then
				batch[#batch+1]=v.uuid
				if #batch>=50 then break end
			end
		end
		if #batch==0 then return false end
		pcall(N.Invoke,"RD_Ingest",batch); invDirty=true
		return true                                    -- còn lô nữa: nhịp sau làm tiếp
	end
	local function mailAndLoot()
		if claimMail() then return end
		local to=CFG.MAIL_TO; if type(to)=="table" then to=to[1] end; to=tostring(to or "")
		if to~="" and type(CFG.MAIL_ITEMS)=="table" then
			for _,want in ipairs(CFG.MAIL_ITEMS) do
				local cls=tostring(want.Class or ""); local wid=tostring(want.Id or "")
				local min,keep=parseAmount(want.MinAmount),parseAmount(want.KeepAmount)
				-- Nhánh riêng: gửi mọi pet Huge/Titanic/Gargantuan, không so Id.
				if cls=="Pet" and wid=="All Huges" and PetItem then
					for _,pet in pairs(each(PetItem)) do
						local okH,huge=pcall(function() return pet:IsHuge() or pet:IsTitanic() or pet:IsGargantuan() end)
						if okH and huge then
							invoke("EF_Relay",to,"",pet.Class.Name,select(2,pcall(pet.GetUID,pet)),1)
							invDirty=true; return                  -- mỗi nhịp gửi 1 con
						end
					end
				else
					local class=Items and Items[cls]
					if class then
						for _,it in pairs(each(class)) do
							if tostring(select(2,pcall(it.GetId,it)))==wid then
								local tier=n1(it.GetTier,it) or 0
								local tierOk=true
								if want.Tier~=nil then
									if type(want.Tier)=="table" then
										tierOk=false
										for _,t in ipairs(want.Tier) do if tier==tonumber(t) then tierOk=true break end end
									else tierOk=(tier==tonumber(want.Tier)) end
								end
								local amt=n1(it.GetAmount,it) or 0
								if tierOk and amt>=min and amt-keep>0 then
									invoke("EF_Relay",to,"",it.Class.Name,select(2,pcall(it.GetUID,it)),math.floor(amt-keep))
									invDirty=true; return                -- mỗi nhịp gửi 1 món
								end
							end
						end
					end
				end
			end
		end
		local lootId=tostring(CFG.OPEN_LOOTBOX or ""); if lootId~="" and Signal and LootboxItem then for _,it in pairs(each(LootboxItem)) do if tostring(select(2,pcall(it.GetId,it)))==lootId and (n1(it.GetAmount,it) or 0)>1 then pcall(Signal.Invoke,"Lootbox_RequestOpen",lootId,math.min(8,n1(it.GetAmount,it) or 1)); invDirty=true; return end end end
	end
	local notifySeen={}
	local function notify()
		local url=tostring(CFG.Webhook or ""); if url=="" or type(CFG.NOTIFY)~="table" or #CFG.NOTIFY==0 then return end
		local request=(syn and syn.request) or (http and http.request) or http_request or request; if type(request)~="function" then return end
