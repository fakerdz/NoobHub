			SortOrder = Enum.SortOrder.LayoutOrder }, p)
	end
	grid(upgBox, 76, 46); grid(equipBox, 52, 46); grid(countBox, 52, 46); grid(goalBox, 130, 62)
	uiMake("UIListLayout", { Padding = UDim.new(0, 6) }, statsBox)

	local function statRow(label)
		local row = uiMake("Frame", { Size = UDim2.new(1, 0, 0, 24), BackgroundTransparency = 1 }, statsBox)
		uiMake("TextLabel", { Position = UDim2.fromOffset(2, 0), Size = UDim2.new(0.5, 0, 1, 0), BackgroundTransparency = 1,
			Font = Enum.Font.Gotham, TextSize = 12, TextXAlignment = Enum.TextXAlignment.Left,
