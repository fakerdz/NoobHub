-- Pinata đã kịch trần: nâng nữa cũng không lên. Cùng 2 điều kiện mà runChallenge
-- dùng để ngừng arm lượt mới - level >= maxLevel (trần của game), hoặc
-- displayLevel >= Limit_Level_Challenge (trần mình tự đặt).
local function pinataMaxed()
	local s = chState
	if type(s) ~= "table" then return false end
	local level, maxLevel = tonumber(s.level), tonumber(s.maxLevel)
	if level and maxLevel and level >= maxLevel then return true end
	local limit = tonumber(CFG.LIMIT_LEVEL_CHALLENGE) or 0
	if limit > 0 then
		local disp = tonumber(s.displayLevel) or ((level or -1) + 1)
		if disp >= limit then return true end
	end
	return false
end

