			else
				if timeUp() then
					switchTo("challenge")            -- het gio, dang o lobby -> doi mode
				else
					local enteredLobby = select(2, pcall(enterLobby))
					if enteredLobby and inLobby() then
						pcall(startRaid)                 -- chi tao khi da vao lobby that
					end
				end
			end
		end
		-- Yield mot frame de tranh vong lap nong; khong con delay co dinh 2 giay.
		task.wait()
	end
end)
-- HUD chạy trong HÀM RIÊNG: Luau giới hạn 200 local mỗi hàm, để chung thân
-- file là tràn register ("Out of local registers ... exceeded limit 200").
task.spawn(function()
	--// Pinata Fiesta - HUD (hoc tu AutoWorldRank + PvC, BO check rank).
	--//   STATS: Maze Level | Fiesta Coins | Fiesta Orb | Pinata Level
	--//   MAZE UPGRADE: hien tier/max cac upgrade Fiesta (mua auto ben Fiesta_All)
	--//   EQUIPPED PETS + COUNT ITEMS (inventory giu trong RAM giong AutoWorldRank)
	--// Chay kem Fiesta_All.lua (doc ENV._PinataMaze de show mode). Ngan + toi uu.
	local UIS     = game:GetService("UserInputService")
	local Tween   = game:GetService("TweenService")
	local Cur        = Currency
	local Pet        = PetCmds
	local FiestaCredits = req("Util.FiestaCredits")
	local Save       = req("Client.Save")
	local ItemMods = {
		Pet = PetItem, Potion = PotionItem, Fruit = FruitItem, Misc = MiscItem, Enchant = EnchantItem,
		-- lootbox / quà event: Class = "Lootbox", Id = tên trong __DIRECTORY.Lootboxes
		Lootbox = req("Items.LootboxItem"), Currency = req("Items.CurrencyItem"),
	}

	-- so lon -> chu ngan (12.3M ...)
	local SUF = { "", "K", "M", "B", "T", "Qa", "Qi", "Sx", "Sp", "Oc", "No", "Dc" }
	local function short(n)
		n = tonumber(n) or 0
		local i = 1
		while math.abs(n) >= 1000 and i < #SUF do n = n / 1000; i = i + 1 end
		return (i == 1) and tostring(math.floor(n)) or string.format("%.2f%s", n, SUF[i])
	end
	local function curAmt(id) local ok, v = pcall(Cur.Get, id); return ok and tonumber(v) or 0 end
	local function curIcon(id) local ok, it = pcall(Cur.GetItem, id); return (ok and it) and select(2, pcall(function() return it:GetIcon() end)) or "" end

	-- ===== DU LIEU =====
	local SHORT = { FiestaDamage = "Damage", FiestaSmashSpeed = "Speed", FiestaPets = "Pets",
		FiestaKeyDrops = "Keys", FiestaBetterLoot = "Loot", FiestaMoreCurrency = "Coins+", FiestaXP = "XP" }
	local function upgList()
		local out = {}
		local ids = (type(CFG.UPGRADES) == "table" and #CFG.UPGRADES > 0) and CFG.UPGRADES
			or { "FiestaDamage", "FiestaSmashSpeed", "FiestaPets", "FiestaKeyDrops" }
		for _, id in ipairs(ids) do
			local dir = EventUpgDir and EventUpgDir[id]
			if type(dir) == "table" and dir.TierPowers then
				local tier = tonumber((select(2, pcall(EventUpg.GetTier, dir)))) or 0
				out[#out + 1] = { icon = dir.Icon, tier = tier, max = #dir.TierPowers, name = SHORT[id] or id }
			end
		end
		return out
	end
	local function equipList()
		local g, total = {}, 0
		for _, it in pairs(select(2, pcall(Pet.GetEquippedItems)) or {}) do
			local id = tostring(select(2, pcall(function() return it:GetId() end)))
			local e = g[id]
			if e then e.count = e.count + 1
			else g[id] = { id = id, count = 1, icon = select(2, pcall(function() return it:GetIcon() end)) } end
			total = total + 1
		end
		local out = {}
		for _, e in pairs(g) do out[#out + 1] = e end
		table.sort(out, function(a, b) return a.count > b.count end)
		return out, total
	end
	-- COUNT_ITEMS = { {Class="Misc", Id="Fiesta Key"}, {Class="Pet", Id="All Huges"}, ... }
	local function ruleMatch(want, it)
		local id = select(2, pcall(function() return it:GetId() end))
		local wid = want.Id
		if wid and wid ~= "" and wid ~= "All" then
			if wid == "All Huges" then
				local h = select(2, pcall(function() return it:IsHuge() or it:IsTitanic() or it:IsGargantuan() end))
				if not h then return false end
			elseif tostring(wid) ~= tostring(id) then return false end
		end
		if want.Tier ~= nil then
			local tier = tonumber((select(2, pcall(function() return it:GetTier() end)))) or 0
			if tier ~= tonumber(want.Tier) then return false end
		end
		return true, tostring(id)
	end
	local countCacheAt, countCache = -1, {}
	local function countList()
		local cfg = CFG.COUNT_ITEMS or { { Class = "Misc", Id = "Fiesta Key" }, { Class = "Pet", Id = "All Huges" } }
		if countCacheAt == invAt and countCache.cfg == cfg then return countCache end
		local g = {}
		for ri, want in ipairs(cfg) do
			local cls = ItemMods[tostring(want.Class or "")]
			if cls then
				local expand = not want.Id or want.Id == "" or want.Id == "All" or want.Id == "All Huges"
				for _, it in pairs(each(cls)) do
					local ok, id = ruleMatch(want, it)
					if ok then
						local amt = math.max(0, tonumber((select(2, pcall(function() return it:GetAmount() end)))) or 1)
						if amt > 0 then
							local key = ri .. (expand and ("|" .. id) or "")
							local e = g[key]
							if e then e.count = e.count + amt
							else g[key] = { id = id, count = amt, icon = select(2, pcall(function() return it:GetIcon() end)) } end
						end
					end
				end
			end
		end
		local out = { cfg = cfg }
		for _, e in pairs(g) do out[#out + 1] = e end
		table.sort(out, function(a, b) return a.count > b.count end)
		countCacheAt, countCache = invAt, out
		return out
	end

	-- Exact Fiesta ladder contract from FiestaCredits + Fiesta_LadderState.
	local ladderState
	pcall(function()
		Net.Fired("Fiesta_LadderState"):Connect(function(state)
			if type(state) == "table" then ladderState = state end
		end)
		Net.Fired("Fiesta_LadderAward"):Connect(function(award)
			if type(award) ~= "table" then return end
			ladderState = ladderState or {}
			for id, amount in pairs(award) do
				if type(amount) == "number" and amount > 0 then ladderState[id] = (tonumber(ladderState[id]) or 0) + amount end
			end
		end)
		Net.Fired("Fiesta_LadderReset"):Connect(function()
			ladderState = ladderState or {}
			for _, entry in ipairs(FiestaCredits.Ladder) do ladderState[entry.Id] = 0 end
		end)
	end)
	local function fiestaRewardIcon(entry)
		if not (Items and entry and entry.RewardId) then return "" end
		local ok, icon = pcall(function()
			local item = entry.RewardKind == "Lootbox" and Items.Lootbox(entry.RewardId) or Items.Pet(entry.RewardId)
			return item:GetIcon()
		end)
		return ok and type(icon) == "string" and icon or ""
	end
	local function getGoalRows()
		if not (FiestaCredits and Save) then return {} end
		local save = select(2, pcall(Save.Get))
		local out = {}
		for _, entry in ipairs(FiestaCredits.Ladder) do
			local progress = ladderState and ladderState[entry.Id]
			if type(progress) ~= "number" and type(save) == "table" then progress = save[entry.SaveKey] end
			if type(progress) == "number" then
				out[#out + 1] = {
					label = entry.DisplayName, progress = progress, amount = entry.CreditsRequired,
					icon = fiestaRewardIcon(entry), rewardId = entry.RewardId,
				}
			end
		end
		return out
	end

	-- ===== HUD (uiMake + panel + cell, hoc AutoWorldRank/PvC) =====
	local function uiMake(class, props, parent)
		local o = Instance.new(class)
		for k, v in pairs(props or {}) do o[k] = v end
		o.Parent = parent; return o
	end
	local RAINBOW = ColorSequence.new({
		ColorSequenceKeypoint.new(0.00, Color3.fromRGB(255, 90, 90)),
		ColorSequenceKeypoint.new(0.25, Color3.fromRGB(255, 190, 70)),
		ColorSequenceKeypoint.new(0.50, Color3.fromRGB(110, 255, 130)),
		ColorSequenceKeypoint.new(0.75, Color3.fromRGB(80, 200, 255)),
		ColorSequenceKeypoint.new(1.00, Color3.fromRGB(200, 120, 255)),
	})
	local grads = {}
	local function rainbow(inst, tr)
		local g = uiMake("UIGradient", { Color = RAINBOW }, inst)
		if tr then g.Transparency = NumberSequence.new(tr) end
		grads[#grads + 1] = g; return g
	end

	local HUD_W, HUD_H = 700, 600
	local PG = LP:WaitForChild("PlayerGui")
	local old = PG:FindFirstChild("Fiesta_HUD"); if old then old:Destroy() end
	local gui = uiMake("ScreenGui", { Name = "Fiesta_HUD", ResetOnSpawn = false, IgnoreGuiInset = true,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling }, PG)
	local root = uiMake("Frame", { Size = UDim2.fromOffset(HUD_W, HUD_H), Position = UDim2.fromOffset(20, 90),
		BackgroundColor3 = Color3.fromRGB(14, 15, 20), BorderSizePixel = 0 }, gui)
	uiMake("UICorner", { CornerRadius = UDim.new(0, 12) }, root)
	rainbow(uiMake("UIStroke", { Thickness = 2.5 }, root))
	local scale = uiMake("UIScale", { Scale = 1 }, root)
	local function fit()
		local vp = workspace.CurrentCamera and workspace.CurrentCamera.ViewportSize
		if not vp or vp.X < 1 then return end
		scale.Scale = math.clamp(math.min(vp.X / (HUD_W + 40), vp.Y / (HUD_H + 120)), 0.5, 1)
	end
	pcall(fit)
	if workspace.CurrentCamera then
		workspace.CurrentCamera:GetPropertyChangedSignal("ViewportSize"):Connect(function() pcall(fit) end)
	end

	-- header
	local header = uiMake("Frame", { Size = UDim2.new(1, 0, 0, 46), BackgroundColor3 = Color3.fromRGB(22, 23, 31),
		BorderSizePixel = 0 }, root)
	uiMake("UICorner", { CornerRadius = UDim.new(0, 12) }, header)
	rainbow(header, 0.85)
	local avatar = uiMake("ImageLabel", { Size = UDim2.fromOffset(32, 32), Position = UDim2.fromOffset(10, 7),
		BackgroundColor3 = Color3.fromRGB(35, 36, 48), BorderSizePixel = 0,
		Image = ("rbxthumb://type=AvatarHeadShot&id=%d&w=150&h=150"):format(LP.UserId) }, header)
	uiMake("UICorner", { CornerRadius = UDim.new(1, 0) }, avatar)
	uiMake("TextLabel", { Size = UDim2.fromOffset(240, 18), Position = UDim2.fromOffset(50, 6), BackgroundTransparency = 1,
		Font = Enum.Font.GothamBold, TextSize = 14, TextXAlignment = Enum.TextXAlignment.Left,
		TextColor3 = Color3.new(1, 1, 1), Text = LP.DisplayName }, header)
	local subLbl = uiMake("TextLabel", { Size = UDim2.new(1, -100, 0, 14), Position = UDim2.fromOffset(50, 24),
		BackgroundTransparency = 1, Font = Enum.Font.Gotham, TextSize = 11, TextXAlignment = Enum.TextXAlignment.Left,
		TextColor3 = Color3.fromRGB(150, 152, 175), Text = "MODE: STANDBY  |  SWITCHING" }, header)
	local minBtn = uiMake("TextButton", { Size = UDim2.fromOffset(28, 28), Position = UDim2.new(1, -38, 0, 9),
		BackgroundColor3 = Color3.fromRGB(40, 42, 56), BorderSizePixel = 0, Font = Enum.Font.GothamBold,
		TextSize = 18, TextColor3 = Color3.new(1, 1, 1), Text = "-" }, header)
	uiMake("UICorner", { CornerRadius = UDim.new(0, 8) }, minBtn)

	local body = uiMake("Frame", { Size = UDim2.new(1, -16, 1, -56), Position = UDim2.fromOffset(8, 50),
		BackgroundTransparency = 1 }, root)
	local function panel(x, y, w, h, titleText)
		local f = uiMake("Frame", { Position = UDim2.fromOffset(x, y), Size = UDim2.fromOffset(w, h),
			BackgroundColor3 = Color3.fromRGB(21, 22, 30), BorderSizePixel = 0 }, body)
		uiMake("UICorner", { CornerRadius = UDim.new(0, 10) }, f)
		rainbow(uiMake("UIStroke", { Thickness = 1.4, Transparency = 0.35 }, f))
		local title = uiMake("TextLabel", { Size = UDim2.new(1, -16, 0, 14), Position = UDim2.fromOffset(8, 6),
			BackgroundTransparency = 1, Font = Enum.Font.GothamBold, TextSize = 11,
			TextXAlignment = Enum.TextXAlignment.Left, TextColor3 = Color3.new(1, 1, 1), Text = titleText }, f)
		rainbow(title)
		local inner = uiMake("ScrollingFrame", { Position = UDim2.fromOffset(6, 24), Size = UDim2.new(1, -12, 1, -30),
