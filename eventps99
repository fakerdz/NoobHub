			local ok,res=pcall(request,{Url="https://api.noobhub.click/checkkey",Method="POST",Headers={["Content-Type"]="application/json",Accept="application/json"},Body=Http:JSONEncode(body)})
			if not ok or type(res)~="table" then return false,0 end
			local code=tonumber(res.StatusCode or res.status_code or res.Status or res.status) or 0; local data; pcall(function() data=Http:JSONDecode(tostring(res.Body or res.body or "")) end); return true,code,data
		end
		local ok,code,data=ask(); if not(ok and code==200 and data and data.ok==true) then
			local reason=tostring(data and (data.reason or data.error) or (ok and ("HTTP "..tostring(code)) or "Cant Connect"))
			ENV.__FIESTA_KEY_STATUS={ok=ok,code=code,reason=reason}   -- doc bang getgenv().__FIESTA_KEY_STATUS
			pcall(LP.Kick,LP,reason); return false
		end
		local misses=0; add("key",20,function() local good,status,info=ask(); if good and status==200 and info and info.ok==true then misses=0 elseif good and status==403 then pcall(LP.Kick,LP,tostring(info and (info.reason or info.error) or "[NOOB HUB] Invalid Key")); return "done" else misses=misses+1; if misses>=3 then pcall(LP.Kick,LP,"[NOOB HUB] Cant Connect"); return "done" end end end); return true
	end
