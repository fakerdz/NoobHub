-- Lưu tiến độ ra file NoobHub/<user>.json (học cách của AutoWorldRank): out game
-- rồi vào lại vẫn đúng mode và đúng số phút đã chạy, không bị reset về đầu.
local HUB do
	local Http = game:GetService("HttpService")
	local DIR  = "NoobHub"
	local FILE = DIR .. "/" .. LP.Name .. ".json"
	local can  = typeof(isfolder) == "function" and typeof(writefile) == "function"
	local data = {}
	local function ensure() if not isfolder(DIR) then makefolder(DIR) end end
	local function save()
		if not can then return end
		pcall(function()
			ensure()
			data.User, data.UserId = LP.Name, LP.UserId
			data.LastPlayed = os.time()
			writefile(FILE, Http:JSONEncode(data))
		end)
	end
	if can then
		pcall(function()
			ensure()
			if isfile(FILE) then
				local d = Http:JSONDecode(readfile(FILE))
				if type(d) == "table" then data = d end
			end
		end)
	end
	HUB = { Save = save, Data = function() return data end, Enabled = can }
end

-- Khôi phục mode + số giây đã chạy của mode đó. Dùng os.time() (giờ thật) để
-- tính, os.clock() reset mỗi lần vào game nên không dùng lưu được.
local challengeDisabled = (tonumber(CFG.CHALLENGE_MIN) or 10) <= 0
local S = {
	mode = challengeDisabled and "raid" or ((CFG.FIRST_MODE == "raid") and "raid" or "challenge"),
	start = os.clock(),
	-- Time_Challenge = 0 disables the whole mode timer; Time_Raid is then ignored.
	noTime = challengeDisabled,
}
do
	local d = HUB.Data()
	local m = tostring(d.Mode or "")
	local spent = tonumber(d.ModeSpent) or 0
	local at = tonumber(d.ModeSavedAt) or 0
	if (m == "raid" or m == "challenge") and CFG.RESUME ~= false then
		S.mode = m
		-- cộng cả thời gian offline? KHÔNG: chỉ giữ phần đã chạy trước khi out.
		S.start = os.clock() - math.max(0, math.min(spent, 24 * 3600))
		if at > 0 and os.time() - at > (tonumber(CFG.RESUME_MAX_GAP) or 3600) then
			S.start = os.clock()          -- nghỉ quá lâu -> coi như bắt đầu lại mode
		end
	end
end
if challengeDisabled then
	-- Do not resume a stale challenge state when challenge mode is disabled.
	S.mode, S.start, S.noTime = "raid", os.clock(), true
end
CFG.mode = S.mode
local function minsFor(m)
	local configured = tonumber((m == "raid") and CFG.RAID_MIN or CFG.CHALLENGE_MIN)
	if configured == nil then return (m == "raid") and 30 or 10 end
	return configured
end
local function timeUp()
	if S.noTime then return false end
	local minutes = minsFor(S.mode)
	return minutes > 0 and os.clock() - S.start >= minutes * 60
end
local function saveProgress()
	local d = HUB.Data()
	d.Mode = S.mode
	d.ModeSpent = math.floor(math.max(0, os.clock() - S.start))
	d.ModeSavedAt = os.time()
	d.TotalTime = math.floor((tonumber(d.TotalTime) or 0) + (tonumber(CFG.SAVE_EVERY) or 15))
	HUB.Save()
end
local function syncModeState()
	CFG.mode = S.mode
	if S.noTime then
		CFG.modeEndsAt = nil
		return
	end
	local minutes = minsFor(S.mode)
	CFG.modeEndsAt = minutes > 0 and S.start + minutes * 60 or nil
end
local function switchTo(m)
	S.mode = m; S.start = os.clock(); syncModeState()
	pcall(saveProgress)                 -- đổi mode là ghi ngay, khỏi mất mốc
end
