	-- Đọc BreakableFrontend.createModel: model tên = uid, PrimaryPart là part/mesh
	-- chính, PrimaryPart có con "Hitbox" (part trong suốt + ClickDetector).
	-- Mọi chỗ khác của game chỉ dùng model.PrimaryPart / :FindFirstChild("Hitbox")
	-- (đều có guard), nên xoá phần còn lại là an toàn.
	-- Ta đánh bằng remote Breakables_PlayerDealDamage -> không cần ClickDetector,
	-- không cần thấy hình. Bỏ CanQuery còn cắt luôn mouse.Target của
	-- startGlowAnimationTask (vòng chạy mỗi frame trên PC).
	local proxied = setmetatable({}, { __mode = "k" })
	local function proxyBreakable(model)
		if not (model and model:IsA("Model")) or proxied[model] then return end
		local primary = model.PrimaryPart
		if not primary then return end            -- chưa dựng xong, lần ChildAdded sau
		proxied[model] = true
		for _, child in ipairs(model:GetChildren()) do
			if child ~= primary then pcall(child.Destroy, child) end
		end
		for _, child in ipairs(primary:GetChildren()) do
			if child.Name ~= "Hitbox" then pcall(child.Destroy, child) end
		end
		pcall(function()
			local hitbox = primary:FindFirstChild("Hitbox")
			if hitbox then hitbox.CanQuery, hitbox.CanTouch, hitbox.CanCollide = false, false, false end
			primary.Transparency = 1
			primary.CastShadow = false
			primary.CanCollide, primary.CanTouch, primary.CanQuery = false, false, false
			primary.Reflectance = 0
			primary.Material = Enum.Material.Plastic
		end)
	end
