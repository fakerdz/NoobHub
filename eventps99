				TextXAlignment = Enum.TextXAlignment.Right, TextColor3 = Color3.fromRGB(255, 226, 120),
				TextStrokeTransparency = 0.35 }, box)
			uiMake("TextLabel", { Name = "Bottom", Size = UDim2.new(1, -4, 0, 12), Position = UDim2.new(0, 2, 1, -13),
				BackgroundTransparency = 1, Font = Enum.Font.Gotham, TextSize = 10, TextColor3 = Color3.fromRGB(175, 178, 200),
				TextTruncate = Enum.TextTruncate.AtEnd }, box)
		end
		box.LayoutOrder = index; box.Visible = true
		box.Icon.Image = tostring(icon or ""); box.Corner.Text = tostring(corner or ""); box.Bottom.Text = tostring(bottom or "")
	end
	local function goalCell(index, title, progress, amount, icon)
		local row = goalBox:FindFirstChild("G" .. index)
		if not row then
			row = uiMake("Frame", { Name = "G" .. index, BackgroundColor3 = Color3.fromRGB(30, 31, 42), BorderSizePixel = 0 }, goalBox)
			uiMake("UICorner", { CornerRadius = UDim.new(0, 8) }, row)
			uiMake("UIStroke", { Thickness = 1, Transparency = 0.55, Color = Color3.fromRGB(105, 108, 138) }, row)
			uiMake("ImageLabel", { Name = "Icon", Size = UDim2.fromOffset(48, 48), Position = UDim2.fromOffset(5, 7),
				BackgroundTransparency = 1, ScaleType = Enum.ScaleType.Fit }, row)
			uiMake("TextLabel", { Name = "Title", Position = UDim2.fromOffset(57, 7), Size = UDim2.new(1, -61, 0, 24), BackgroundTransparency = 1,
				Font = Enum.Font.GothamBold, TextSize = 10, TextWrapped = true, TextXAlignment = Enum.TextXAlignment.Left,
				TextYAlignment = Enum.TextYAlignment.Center, TextColor3 = Color3.new(1, 1, 1) }, row)
			uiMake("TextLabel", { Name = "Value", Position = UDim2.fromOffset(57, 34), Size = UDim2.new(1, -61, 0, 18), BackgroundTransparency = 1,
				Font = Enum.Font.GothamBold, TextSize = 10, TextXAlignment = Enum.TextXAlignment.Left, TextColor3 = Color3.fromRGB(255, 226, 120) }, row)
		end
		row.LayoutOrder, row.Visible = index, true
		local image = tostring(icon or "")
		row.Icon.Image = image:match("^%d+$") and ("rbxassetid://" .. image) or image
		row.Title.Text = tostring(title or "Fiesta Goal")
		row.Value.Text = ("%s/%s points"):format(short(progress), short(amount))
	end
	local function trimGoals(used)
		local i = used + 1
		while true do local row = goalBox:FindFirstChild("G" .. i); if not row then break end row.Visible = false; i = i + 1 end
	end

	-- ===== REFRESH =====
	local function refresh()
		vMaze.Text = short((select(2, pcall(RaidCmds.GetDifficultyLevel))) or 0)
		vCoins.Text = short(curAmt("FiestaCoins"))
		vOrb.Text = short(curAmt("FiestaOrbs"))
		local pinataRaw = tonumber(chState and (chState.level or chState.Level))
		vPinata.Text = short(tonumber(chState and chState.displayLevel) or (pinataRaw and pinataRaw + 1) or tonumber(CFG.pinataLevel) or 0)
		if pinataMaxed() then
			S.noTime = true
			CFG.modeEndsAt = nil
		end

		local up = upgList()
		for i, u in ipairs(up) do cell(upgBox, i, u.icon, ("%d/%d"):format(u.tier, u.max), u.name) end
		trim(upgBox, #up)

		local eq, eqTot = equipList()
		for i, e in ipairs(eq) do cell(equipBox, i, e.icon, "x" .. e.count, e.id) end
		trim(equipBox, #eq)

		local ct = countList()
		for i, e in ipairs(ct) do cell(countBox, i, e.icon, "x" .. short(e.count), e.id) end
		trim(countBox, #ct)
		if countTitle then countTitle.Text = ("COUNT ITEMS  (%d)"):format(#ct) end
		local goals = getGoalRows()
		for i, goal in ipairs(goals) do goalCell(i, goal.label, goal.progress, goal.amount, goal.icon) end
		trimGoals(#goals)
		if goalTitle then goalTitle.Text = ("FIESTA GOALS  (%d)"):format(#goals) end

		local mode = tostring(CFG.mode or "standby"):upper()
		local left = math.max(0, (tonumber(CFG.modeEndsAt) or 0) - os.clock())
		local countdown = S.noTime and "NO LIMIT"
			or ((left > 0) and ("SWITCH IN %02d:%02d"):format(math.floor(left / 60), math.floor(left % 60)) or "SWITCHING")
		subLbl.Text = ("MODE: %s  |  %s  |  EQUIP %d"):format(mode, countdown, eqTot)
	end

	task.spawn(function()
		while alive() and gui.Parent do
			if body.Visible then pcall(refresh) end
			task.wait(1)
		end
	end)
	task.spawn(function()   -- rainbow chay
		while alive() and gui.Parent do
			if body.Visible then
				local r = os.clock() * 90 % 360
				for i = #grads, 1, -1 do
					local g = grads[i]
					if g.Parent then g.Rotation = (r + i * 7) % 360 else table.remove(grads, i) end
				end
			end
			task.wait(tonumber(CFG.HUD_FX_STEP) or 0.5)   -- gradient chỉ là hiệu ứng, 0.08s quá phí
		end
	end)

	-- minimize
	local minimized = false
	minBtn.MouseButton1Click:Connect(function()
		minimized = not minimized
		body.Visible = not minimized
		minBtn.Text = minimized and "+" or "-"
		Tween:Create(root, TweenInfo.new(0.2, Enum.EasingStyle.Quad),
			{ Size = minimized and UDim2.fromOffset(HUD_W, 46) or UDim2.fromOffset(HUD_W, HUD_H) }):Play()
	end)
	-- keo tha
	do
		local dragging, startInput, startPos
		header.InputBegan:Connect(function(i)
			if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
				dragging, startInput, startPos = true, i.Position, root.Position
				i.Changed:Connect(function() if i.UserInputState == Enum.UserInputState.End then dragging = false end end)
			end
		end)
		UIS.InputChanged:Connect(function(i)
			if dragging and alive() and (i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch) then
				local d = i.Position - startInput
				root.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + d.X, startPos.Y.Scale, startPos.Y.Offset + d.Y)
			end
		end)
	end
end)
end)
if not __FIESTA_OK then
	local env = (getgenv and getgenv()) or _G
	if type(env) == "table" then env.__FIESTA_LAST_ERROR = tostring(__FIESTA_ERROR) end
	pcall(function() warn("[Fiesta_All] fatal: " .. tostring(__FIESTA_ERROR)) end)
end
